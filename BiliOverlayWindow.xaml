<Window x:Class="MinecraftChatOverlay.BiliOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MinecraftChatOverlay.ViewModels"
        Title="Bilibili 直播弹幕悬浮窗"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- 弹幕行：普通弹幕和 SC 共用。SC 行会多一个 SC 标识（在舰长标识之前，不影响舰长标识） -->
        <DataTemplate DataType="{x:Type vm:DanmakuRowViewModel}">
            <Border Margin="0,1,0,1" Padding="2,1">
                <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32"
                            CornerRadius="16"
                            Background="#44000000"
                            BorderBrush="#55FFFFFF"
                            BorderThickness="1"
                            VerticalAlignment="Top">
                        <Image Source="{Binding Avatar}"
                               Width="30" Height="30"
                               Stretch="UniformToFill"
                               Margin="0">
                            <Image.Clip>
                                <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15"/>
                            </Image.Clip>
                        </Image>
                    </Border>

                    <StackPanel Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <!-- SC 标识 -->
                            <Border Background="{Binding ScBadgeBrush}"
                                    CornerRadius="2"
                                    Padding="3,0"
                                    Margin="0,0,3,0"
                                    Visibility="{Binding HasScBadge, Converter={StaticResource BoolToVisibility}}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding ScBadgeText}"
                                           FontSize="10"
                                           Foreground="White"
                                           FontWeight="Bold"/>
                            </Border>
                            <!-- 舰长标识 -->
                            <Border Background="{Binding GuardBrush}"
                                    CornerRadius="2"
                                    Padding="3,0"
                                    Margin="0,0,3,0"
                                    Visibility="{Binding HasGuard, Converter={StaticResource BoolToVisibility}}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding GuardText}"
                                           FontSize="10"
                                           Foreground="White"
                                           FontWeight="Bold"/>
                            </Border>
                            <!-- 粉丝牌 -->
                            <Border Background="{Binding MedalBrush}"
                                    CornerRadius="2"
                                    Padding="4,0"
                                    Visibility="{Binding HasMedal, Converter={StaticResource BoolToVisibility}}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding MedalText}"
                                           FontSize="10"
                                           Foreground="#FF333333"
                                           FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="{Binding UserName}"
                                       FontSize="{Binding NameFontSize}"
                                       Foreground="{Binding NameBrush}"
                                       Effect="{Binding NameShadow}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="3,0,0,0"/>
                            <TextBlock Text="{Binding UserIdText}"
                                       FontSize="9"
                                       Foreground="#88FFFFFF"
                                       Effect="{Binding NameShadow}"
                                       VerticalAlignment="Center"
                                       Margin="4,1,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DisplayText}"
                                   TextWrapping="Wrap"
                                   Foreground="{Binding TextBrush}"
                                   Effect="{Binding TextShadow}"
                                   FontSize="{Binding FontSize}"
                                   FontWeight="SemiBold"
                                   MaxWidth="{Binding TextMaxWidth}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 通知行：礼物区和进场区共用（多段彩色文字，横向排布） -->
        <DataTemplate DataType="{x:Type vm:NoticeItemViewModel}">
            <ItemsControl ItemsSource="{Binding Segments}"
                          TextElement.FontSize="{Binding FontSize}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}"
                                   Foreground="{Binding Foreground}"
                                   FontWeight="{Binding FontWeight}"
                                   Effect="{Binding DataContext.Shadow, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="10"
            Background="#66000000"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="8,6">
        <StackPanel>
            <!-- 最上方小字模块 -->
            <StackPanel x:Name="HeaderPanel" Orientation="Horizontal">
                <TextBlock x:Name="RoomTitleText"
                           Text="B站直播间"
                           Foreground="#AAFFFFFF"
                           FontSize="11"
                           Margin="0,0,10,0"
                           MaxWidth="250"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="OnlineText"
                           Text="人气:0"
                           Foreground="White"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- SC 区：头像 + SC 标识 + 粉丝牌 + 用户名 + 可换行正文。没消息时整块收起 -->
            <Border x:Name="ScBorder"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#33FFFFFF"
                    Padding="0,2,0,0"
                    Margin="0,2,0,0"
                    Visibility="Collapsed">
                <ScrollViewer x:Name="ScScroll"
                              MaxHeight="100"
                              VerticalScrollBarVisibility="Hidden"
                              MouseEnter="ScScroll_MouseEnter"
                              MouseLeave="ScScroll_MouseLeave"
                              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                    <ItemsControl x:Name="ScList"/>
                </ScrollViewer>
            </Border>

            <!-- 弹幕区：不显示滚动条，用滚轮翻看；鼠标停在这里看历史时不会被新弹幕抢滚动 -->
            <ScrollViewer x:Name="DanmakuScroll"
                          MaxHeight="620"
                          VerticalScrollBarVisibility="Hidden"
                          Margin="0,4,0,2"
                          MouseEnter="DanmakuScroll_MouseEnter"
                          MouseLeave="DanmakuScroll_MouseLeave"
                          PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                <ItemsControl x:Name="DanmakuList"/>
            </ScrollViewer>

            <!-- 礼物区（礼物 + 大航海）：与其它区各自独立滚动 -->
            <Border x:Name="GiftBorder"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#33FFFFFF"
                    Padding="0,2,0,0"
                    Margin="0,2,0,0"
                    Visibility="Collapsed">
                <ScrollViewer x:Name="GiftScroll"
                              MaxHeight="80"
                              VerticalScrollBarVisibility="Hidden"
                              MouseEnter="GiftScroll_MouseEnter"
                              MouseLeave="GiftScroll_MouseLeave"
                              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                    <ItemsControl x:Name="GiftList"/>
                </ScrollViewer>
            </Border>

            <!-- 进场区（进场 / 关注 / 分享） -->
            <Border x:Name="EntryBorder"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#33FFFFFF"
                    Padding="0,2,0,0"
                    Margin="0,2,0,0"
                    Visibility="Collapsed">
                <ScrollViewer x:Name="EntryScroll"
                              MaxHeight="60"
                              VerticalScrollBarVisibility="Hidden"
                              MouseEnter="EntryScroll_MouseEnter"
                              MouseLeave="EntryScroll_MouseLeave"
                              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                    <ItemsControl x:Name="EntryList"/>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Border>
</Window>
