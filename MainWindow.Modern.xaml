                                                            Style="{StaticResource SmallGhostButtonStyle}"
                                                            VerticalAlignment="Center"
                                                            Margin="12,0,0,0"
                                                            Click="KillFeedbackRuleHelpButton_Click"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="匹配规则（一行一条，命中任意一条就算）"
                                                       Style="{StaticResource FieldLabelStyle}"
                                                       Margin="0,16,0,7"/>
                                            <TextBox x:Name="KillFeedbackRulesTextBox"
                                                     Height="96"
                                                     AcceptsReturn="True"
                                                     TextWrapping="NoWrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                                                     ToolTip="一局里近战 / 远程 / 爆炸的击杀消息往往不是同一个模板，每种粘一条。规则是「一段固定文本」，不要求出现在行首"
                                                     LostFocus="KillFeedbackRulesTextBox_LostFocus"/>
                                            <CheckBox x:Name="KillFeedbackRegexRulesCheckBox"
                                                      Content="按正则解释（不勾就是纯文本，符号不用转义）"
                                                      Style="{StaticResource InlineToggleStyle}"
                                                      Margin="0,10,0,0"
                                                      Checked="KillFeedbackRegexRulesCheckBox_Changed"
                                                      Unchecked="KillFeedbackRegexRulesCheckBox_Changed"/>

                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="KillFeedbackTestTextBox" MinWidth="160" Margin="0,0,9,0"/>
                                                <Button Grid.Column="1"
                                                        Content="试一条"
                                                        Click="KillFeedbackTestButton_Click"
                                                        Style="{StaticResource SmallGhostButtonStyle}"/>
                                            </Grid>
                                            <TextBlock x:Name="KillFeedbackTestResultText"
                                                       Style="{StaticResource HintStyle}"
                                                       Margin="0,8,0,0"/>
                                            <TextBlock x:Name="KillFeedbackStatsText"
                                                       Style="{StaticResource HintStyle}"
                                                       Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="效果预览" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="用你最近一张游戏截图实时演算，点【触发一次】就能看动画。挑定之后搬进游戏里用的是同一套数学，所以这里看到的和游戏里的基本一致"
                                                   Style="{StaticResource CardDescStyle}" Margin="0,3,0,18"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="272"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Margin="0,0,20,0">
                                                <TextBlock Text="反馈效果（可多选，各自设置大小）" Style="{StaticResource FieldLabelStyle}"/>
                                                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                                <StackPanel>
                                                    <!-- 边缘脉冲：色块统一放在最右，让所有数字框对齐成一列 -->
                                                    <Grid Margin="0,0,0,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="64"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="KillEffectEdgeCheckBox" Content="边缘脉冲"
                                                                  VerticalAlignment="Center"
                                                                  ToolTip="勾上以后可以点右边的色块换发光颜色"
                                                                  Checked="KillFeedbackEffectSetting_Changed" Unchecked="KillFeedbackEffectSetting_Changed"/>
                                                        <TextBox x:Name="KillEffectEdgeStrengthTextBox" Grid.Column="1"
                                                                 Style="{StaticResource EffectPercentTextBoxStyle}"
                                                                 Text="60"
                                                                 TextChanged="KillFeedbackEffectText_Changed"/>
                                                        <TextBlock Grid.Column="2" Text="%"
                                                                   Margin="5,0,0,0" VerticalAlignment="Center"
                                                                   Style="{StaticResource HintStyle}"/>
                                                        <Button x:Name="KillEffectEdgeColorButton" Grid.Column="3"
                                                                Style="{StaticResource SwatchButtonStyle}"
                                                                Margin="12,0,0,0"
                                                                VerticalAlignment="Center"
                                                                ToolTip="选择边缘脉冲的发光颜色"
                                                                Click="KillEffectEdgeColorButton_Click">
                                                            <Border x:Name="KillEffectEdgeColorSwatch" Width="16" Height="16" CornerRadius="5" Background="#FFF5E0"/>
                                                        </Button>
                                                    </Grid>
                                                    <!-- 暗角脉冲 -->
                                                    <Grid Margin="0,0,0,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="64"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="38"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="KillEffectVignetteCheckBox" Content="暗角脉冲"
                                                                  VerticalAlignment="Center"
                                                                  Checked="KillFeedbackEffectSetting_Changed" Unchecked="KillFeedbackEffectSetting_Changed"/>
                                                        <TextBox x:Name="KillEffectVignetteStrengthTextBox" Grid.Column="1"
                                                                 Style="{StaticResource EffectPercentTextBoxStyle}"
                                                                 Text="60"
                                                                 TextChanged="KillFeedbackEffectText_Changed"/>
                                                        <TextBlock Grid.Column="2" Text="%"
                                                                   Margin="5,0,0,0" VerticalAlignment="Center"
                                                                   Style="{StaticResource HintStyle}"/>
                                                    </Grid>
                                                    <!-- 色差分离 -->
                                                    <Grid Margin="0,0,0,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="64"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="38"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="KillEffectChromaticCheckBox" Content="色差分离"
                                                                  VerticalAlignment="Center"
                                                                  Checked="KillFeedbackEffectSetting_Changed" Unchecked="KillFeedbackEffectSetting_Changed"/>
                                                        <TextBox x:Name="KillEffectChromaticStrengthTextBox" Grid.Column="1"
                                                                 Style="{StaticResource EffectPercentTextBoxStyle}"
                                                                 Text="60"
                                                                 TextChanged="KillFeedbackEffectText_Changed"/>
                                                        <TextBlock Grid.Column="2" Text="%"
                                                                   Margin="5,0,0,0" VerticalAlignment="Center"
                                                                   Style="{StaticResource HintStyle}"/>
                                                    </Grid>
                                                    <!-- 缩放脉冲 -->
                                                    <Grid Margin="0,0,0,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="64"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="38"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="KillEffectZoomCheckBox" Content="缩放脉冲"
                                                                  VerticalAlignment="Center"
                                                                  Checked="KillFeedbackEffectSetting_Changed" Unchecked="KillFeedbackEffectSetting_Changed"/>
                                                        <TextBox x:Name="KillEffectZoomStrengthTextBox" Grid.Column="1"
                                                                 Style="{StaticResource EffectPercentTextBoxStyle}"
                                                                 Text="60"
                                                                 TextChanged="KillFeedbackEffectText_Changed"/>
                                                        <TextBlock Grid.Column="2" Text="%"
                                                                   Margin="5,0,0,0" VerticalAlignment="Center"
                                                                   Style="{StaticResource HintStyle}"/>
                                                    </Grid>
                                                    <!-- 抖动 -->
                                                    <Grid Margin="0,0,0,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="64"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="38"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="KillEffectShakeCheckBox" Content="抖动"
                                                                  VerticalAlignment="Center"
                                                                  Checked="KillFeedbackEffectSetting_Changed" Unchecked="KillFeedbackEffectSetting_Changed"/>
                                                        <TextBox x:Name="KillEffectShakeStrengthTextBox" Grid.Column="1"
                                                                 Style="{StaticResource EffectPercentTextBoxStyle}"
                                                                 Text="60"
                                                                 TextChanged="KillFeedbackEffectText_Changed"/>
                                                        <TextBlock Grid.Column="2" Text="%"
                                                                   Margin="5,0,0,0" VerticalAlignment="Center"
                                                                   Style="{StaticResource HintStyle}"/>
                                                    </Grid>
                                                    <!-- 全屏闪光 -->
                                                    <Grid Margin="0,0,0,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="64"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="38"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="KillEffectFlashCheckBox" Content="全屏闪光"
                                                                  VerticalAlignment="Center"
                                                                  ToolTip="整个画面短暂变亮；和「暗角脉冲」同时开时会被削弱"
                                                                  Checked="KillFeedbackEffectSetting_Changed" Unchecked="KillFeedbackEffectSetting_Changed"/>
                                                        <TextBox x:Name="KillEffectFlashStrengthTextBox" Grid.Column="1"
                                                                 Style="{StaticResource EffectPercentTextBoxStyle}"
                                                                 Text="60"
                                                                 TextChanged="KillFeedbackEffectText_Changed"/>
                                                        <TextBlock Grid.Column="2" Text="%"
                                                                   Margin="5,0,0,0" VerticalAlignment="Center"
                                                                   Style="{StaticResource HintStyle}"/>
                                                    </Grid>
                                                    <!-- 中心冲击环 -->
                                                    <Grid Margin="0,0,0,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="64"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="38"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="KillEffectShockwaveCheckBox" Content="中心冲击环"
                                                                  VerticalAlignment="Center"
                                                                  ToolTip="一圈光从画面中心向外扩散"
                                                                  Checked="KillFeedbackEffectSetting_Changed" Unchecked="KillFeedbackEffectSetting_Changed"/>
                                                        <TextBox x:Name="KillEffectShockwaveStrengthTextBox" Grid.Column="1"
                                                                 Style="{StaticResource EffectPercentTextBoxStyle}"
                                                                 Text="60"
                                                                 TextChanged="KillFeedbackEffectText_Changed"/>
                                                        <TextBlock Grid.Column="2" Text="%"
                                                                   Margin="5,0,0,0" VerticalAlignment="Center"
                                                                   Style="{StaticResource HintStyle}"/>
                                                    </Grid>
                                                    <!-- 故障撕裂 -->
                                                    <Grid Margin="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="64"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="38"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="KillEffectGlitchCheckBox" Content="故障撕裂"
                                                                  VerticalAlignment="Center"
                                                                  ToolTip="横向块位移 + 红蓝分离"
                                                                  Checked="KillFeedbackEffectSetting_Changed" Unchecked="KillFeedbackEffectSetting_Changed"/>
                                                        <TextBox x:Name="KillEffectGlitchStrengthTextBox" Grid.Column="1"
                                                                 Style="{StaticResource EffectPercentTextBoxStyle}"
                                                                 Text="60"
                                                                 TextChanged="KillFeedbackEffectText_Changed"/>
                                                        <TextBlock Grid.Column="2" Text="%"
                                                                   Margin="5,0,0,0" VerticalAlignment="Center"
                                                                   Style="{StaticResource HintStyle}"/>
                                                    </Grid>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="预览" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBlock x:Name="KillFeedbackPreviewSourceText"
                                                               Grid.Column="1"
                                                               Style="{StaticResource HintStyle}"
                                                               HorizontalAlignment="Right"
                                                               MaxWidth="300"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                                <Border Background="#FF070B0F"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="12"
                                                        ClipToBounds="True"
                                                        HorizontalAlignment="Left"
                                                        Width="392"
                                                        Height="221">
                                                    <Image x:Name="KillFeedbackPreviewImage"
                                                           Stretch="UniformToFill"/>
                                                </Border>
                                                <Grid Margin="0,12,0,0" HorizontalAlignment="Left">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Content="触发一次"
                                                            Click="KillFeedbackTriggerButton_Click"
                                                            Style="{StaticResource SmallPrimaryButtonStyle}"
                                                            Margin="0,0,8,0"/>
                                                    <Button Grid.Column="1"
                                                            Content="换一张截图"
                                                            Click="KillFeedbackPickImageButton_Click"
                                                            Style="{StaticResource SmallGhostButtonStyle}"/>
                                                </Grid>
                                                <TextBlock x:Name="KillFeedbackPreviewStatusText"
                                                           Style="{StaticResource HintStyle}"
                                                           Margin="0,10,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,9,0">
                                                <TextBlock Text="持续时间（所有效果共用）" Style="{StaticResource FieldLabelStyle}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                                                    <Slider x:Name="KillFeedbackDurationSlider" Minimum="120" Maximum="900" Value="380"
                                                            ValueChanged="KillFeedbackSlider_ValueChanged"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Value, ElementName=KillFeedbackDurationSlider, StringFormat={}{0:F0} ms}"
                                                               FontSize="12.5" FontWeight="ExtraBold"
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                                <TextBlock Text="大小说明" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBlock Text="百分比输入，100% = 基准，500% = 5 倍；可多个效果同时开。"
                                                           Style="{StaticResource HintStyle}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border Background="{DynamicResource AccentSoftBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="1"
                                                CornerRadius="13"
                                                Padding="15,13"
                                                Margin="0,18,0,0">
                                            <StackPanel>
                                                <TextBlock Text="匹配和画面效果都已经接上：上面那行计数会跟着真实聊天涨；命中后游戏里会把勾选的效果一起播一遍（OpenGL / Java 版）。除缩放脉冲和抖动外，其余效果都走 core 着色器；极老的兼容上下文只支持这两种。"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="注意：「全屏闪光」和「暗角脉冲」同时开时，闪白会被削弱 —— 暗角是画面最后一步整体压暗，边缘那一圈白光会被一起吃掉（画面越亮越明显，亮的场景里几乎看不出来）。想让闪白最明显，就别同时勾暗角。"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource AmberBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                                                                <!-- 击杀图标（原「击杀横幅」） -->
                                        <Border Style="{StaticResource LockedCardStyle}"
                                                Tag="{Binding IsKillIconCardLocked}"
                                                Margin="0,16,0,0">
                                            <StackPanel>
                                                <TextBlock Text="击杀图标" Style="{StaticResource CardTitleStyle}"/>
                                                <TextBlock Text="击杀后在屏幕上弹出一枚图标（类似 CS / 瓦 的击杀确认）。图标要你自己导入 —— 软件不带现成的，免得版权上说不清。和画面效果、提示音互不影响。"
                                                           Style="{StaticResource CardDescStyle}" Margin="0,3,0,18"/>

                                                <CheckBox x:Name="KillBannerEnableCheckBox"
                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                          Margin="0,0,0,12"
                                                          Checked="KillBannerSetting_Changed"
                                                          Unchecked="KillBannerSetting_Changed">
                                                    <StackPanel>
                                                        <TextBlock Text="击杀时显示图标" FontSize="13" FontWeight="Bold"/>
                                                        <TextBlock Text="只在匹配到你的击杀后弹出"
                                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </CheckBox>

                                                <StackPanel IsEnabled="{Binding IsChecked, ElementName=KillBannerEnableCheckBox}">
                                                    <!-- 图标列表 + 预览 并排 -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                            <TextBlock Text="图标" Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,7"/>
                                                            <ListBox x:Name="KillBannerIconListBox"
                                                                     Height="196"
                                                                     SelectionChanged="KillBannerIconListBox_SelectionChanged">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <!-- 勾选框：参与随机抽取。关掉「随机显示」时收起来，不留空位 -->
                                                                            <CheckBox Grid.Column="0"
                                                                                      IsChecked="{Binding IsPicked, Mode=TwoWay}"
                                                                                      Visibility="{Binding ShowCheckBox, Converter={StaticResource BoolToVisibility}}"
                                                                                      VerticalAlignment="Center"
                                                                                      Checked="KillBannerIconPicked_Changed"
                                                                                      Unchecked="KillBannerIconPicked_Changed"
                                                                                      ToolTip="勾上 = 参与随机抽取"/>
                                                                            <Border Grid.Column="1"
                                                                                    Width="22" Height="22" Margin="9,0,9,0"
                                                                                    VerticalAlignment="Center"
                                                                                    CornerRadius="5"
                                                                                    Background="{DynamicResource Surface2Brush}">
                                                                                <Image Source="{Binding Thumbnail}"
                                                                                       Stretch="Uniform"
                                                                                       Margin="2"
                                                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                            </Border>
                                                                            <TextBlock Grid.Column="2"
                                                                                       Text="{Binding Name}"
                                                                                       VerticalAlignment="Center"
                                                                                       FontSize="13"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>

                                                            <Grid Margin="0,10,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Button Content="添加图标…" Click="KillBannerAddButton_Click"
                                                                        Style="{StaticResource SmallPrimaryButtonStyle}" Margin="0,0,8,0"/>
                                                                <Button Grid.Column="1" Content="移除" Click="KillBannerRemoveButton_Click"
                                                                        Style="{StaticResource SmallDangerButtonStyle}"/>
                                                                <CheckBox Grid.Column="2"
                                                                          x:Name="KillBannerRandomCheckBox"
                                                                          Content="随机显示"
                                                                          Style="{StaticResource InlineToggleStyle}"
                                                                          VerticalAlignment="Center"
                                                                          Margin="14,0,0,0"
                                                                          ToolTip="开启后每次击杀从勾选的图标里随机抽一个；关掉就用列表中选中的那张"
                                                                          Checked="KillBannerRandomCheckBox_Changed"
                                                                          Unchecked="KillBannerRandomCheckBox_Changed"/>
                                                            </Grid>
                                                        </StackPanel>

                                                        <!-- 预览框：假装是游戏画面，看图标落点 -->
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="预览" Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,7"/>
                                                            <Border Width="200" Height="200"
                                                                    CornerRadius="10"
                                                                    Background="{DynamicResource Surface2Brush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    ClipToBounds="True">
                                                                <Grid>
                                                                    <!-- 画面中心十字，标出"准星"在哪 -->
                                                                    <Canvas>
                                                                        <Line X1="100" Y1="92" X2="100" Y2="100"
                                                                              Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1"/>
                                                                        <Line X1="100" Y1="100" X2="100" Y2="108"
                                                                              Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1"/>
                                                                        <Line X1="92" Y1="100" X2="100" Y2="100"
                                                                              Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1"/>
                                                                        <Line X1="100" Y1="100" X2="108" Y2="100"
                                                                              Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1"/>
                                                                    </Canvas>
                                                                    <Image x:Name="KillBannerPreviewImage"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Stretch="Uniform"
                                                                           Visibility="Collapsed"/>
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock x:Name="KillBannerStatusText"
                                                                       FontSize="11.5"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap"
                                                                       MaxWidth="200"
                                                                       Margin="0,6,0,0"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- 外发光颜色（用户图片保持原色，这个只改垫在底下的辉光） -->
                                                    <Grid Margin="0,14,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="外发光颜色" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                                                            <TextBlock Text="图片本身保持原色；这个颜色是垫在底下的一圈辉光，挑对比强一点的更清楚。"
                                                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Style="{StaticResource SwatchButtonStyle}"
                                                                VerticalAlignment="Center"
                                                                ToolTip="选择击杀图标的外发光颜色"
                                                                Click="KillBannerIconColorButton_Click">
                                                            <Border x:Name="KillBannerIconColorSwatch" Width="16" Height="16"
                                                                    CornerRadius="5" Background="#FFFFFF"/>
                                                        </Button>
                                                    </Grid>

                                                    <!-- 位置：拖动定位 + 两个滑块微调 -->
                                                    <Grid Margin="0,16,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="出现位置" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                                                            <TextBlock Text="点右边按钮，图标会真的出现在屏幕上，直接拖到想要的位置松手就保存。"
                                                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <ToggleButton Grid.Column="1"
                                                                      x:Name="KillBannerDragButton"
                                                                      Content="拖动定位"
                                                                      VerticalAlignment="Center"
                                                                      Style="{StaticResource SmallPrimaryToggleButtonStyle}"
                                                                      Checked="KillBannerDragButton_Click"
                                                                      Unchecked="KillBannerDragButton_Click"/>
                                                    </Grid>

                                                    <!-- 位置 X -->
                                                    <TextBlock Text="横向位置" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,7"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                                                        <Slider x:Name="KillBannerPosXSlider" Minimum="0" Maximum="1" Value="0.5"
                                                                ValueChanged="KillBannerSlider_ValueChanged"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Value, ElementName=KillBannerPosXSlider, StringFormat={}{0:P0}}"
                                                                   FontSize="12.5" FontWeight="ExtraBold"
                                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <!-- 位置 Y -->
                                                    <TextBlock Text="纵向位置" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,7"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                                                        <Slider x:Name="KillBannerPosYSlider" Minimum="0" Maximum="1" Value="0.58"
                                                                ValueChanged="KillBannerSlider_ValueChanged"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Value, ElementName=KillBannerPosYSlider, StringFormat={}{0:P0}}"
                                                                   FontSize="12.5" FontWeight="ExtraBold"
                                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <!-- 大小 -->
                                                    <TextBlock Text="图标大小" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,7"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                                                        <Slider x:Name="KillBannerSizeSlider" Minimum="24" Maximum="320" Value="96"
                                                                ValueChanged="KillBannerSlider_ValueChanged"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Value, ElementName=KillBannerSizeSlider, StringFormat={}{0:F0} px}"
                                                                   FontSize="12.5" FontWeight="ExtraBold"
                                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <!-- 三段时长 -->
                                                    <TextBlock Text="出现节奏" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,3"/>
                                                    <TextBlock Text="三段相加就是图标从出现到消失的总时长。中间那段是「停住让你看清」的时间。"
                                                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="78"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="72"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="淡入" FontSize="12.5" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <Slider Grid.Column="1" x:Name="KillBannerFadeInSlider"
                                                                Minimum="0" Maximum="2000" Value="150"
                                                                ValueChanged="KillBannerSlider_ValueChanged"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Value, ElementName=KillBannerFadeInSlider, StringFormat={}{0:F0} ms}"
                                                                   FontSize="12.5" FontWeight="ExtraBold"
                                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="78"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="72"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="停留" FontSize="12.5" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <Slider Grid.Column="1" x:Name="KillBannerHoldSlider"
                                                                Minimum="0" Maximum="6000" Value="600"
                                                                ValueChanged="KillBannerSlider_ValueChanged"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Value, ElementName=KillBannerHoldSlider, StringFormat={}{0:F0} ms}"
                                                                   FontSize="12.5" FontWeight="ExtraBold"
                                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="78"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="72"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="淡出" FontSize="12.5" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <Slider Grid.Column="1" x:Name="KillBannerFadeOutSlider"
                                                                Minimum="0" Maximum="2000" Value="200"
                                                                ValueChanged="KillBannerSlider_ValueChanged"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Value, ElementName=KillBannerFadeOutSlider, StringFormat={}{0:F0} ms}"
                                                                   FontSize="12.5" FontWeight="ExtraBold"
                                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <Button Content="在屏幕上试一下"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,18,0,0"
                                                            Click="KillBannerTestButton_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

<!-- 击杀提示音 -->
                                        <Border Style="{StaticResource LockedCardStyle}"
                                                Tag="{Binding IsKillSoundCardLocked}"
                                                Margin="0,16,0,0">
                                            <StackPanel>
                                                <TextBlock Text="击杀提示音" Style="{StaticResource CardTitleStyle}"/>
                                                <TextBlock Text="检测到你的击杀时播放提示音。音效要你自己加 —— 软件不带现成的。和上面的画面效果互不影响。"
                                                           Style="{StaticResource CardDescStyle}" Margin="0,3,0,18"/>

                                                <CheckBox x:Name="KillSoundEnableCheckBox"
                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                          Margin="0,0,0,12"
                                                          Checked="KillSoundEnableCheckBox_Changed"
                                                          Unchecked="KillSoundEnableCheckBox_Changed">
                                                    <StackPanel>
                                                        <TextBlock Text="击杀时播放提示音" FontSize="13" FontWeight="Bold"/>
                                                        <TextBlock Text="只在匹配到你的击杀后播放"
                                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </CheckBox>

                                                <StackPanel IsEnabled="{Binding IsChecked, ElementName=KillSoundEnableCheckBox}">
                                                    <TextBlock Text="提示音" Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,7"/>
                                                    <ListBox x:Name="KillSoundChoiceListBox"
                                                             MinHeight="90"
                                                             MaxHeight="190"
                                                             ItemTemplate="{StaticResource SoundChoiceItemTemplate}"
                                                             SelectionChanged="KillSoundChoiceListBox_SelectionChanged"/>
                                                    <Grid Margin="0,12,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button Content="试听" Click="PreviewKillSoundButton_Click"
                                                                Style="{StaticResource SmallPrimaryButtonStyle}" Margin="0,0,8,0"/>
                                                        <Button Grid.Column="1" Content="添加音效…" Click="BrowseKillSoundFileButton_Click"
                                                                Style="{StaticResource SmallGhostButtonStyle}" Margin="0,0,8,0"/>
                                                        <Button Grid.Column="2" Content="移除" Click="RemoveKillSoundChoiceButton_Click"
                                                                Style="{StaticResource SmallDangerButtonStyle}"/>
                                                        <CheckBox Grid.Column="3"
                                                                  x:Name="KillSoundRandomCheckBox"
                                                                  Content="随机播放"
                                                                  Style="{StaticResource InlineToggleStyle}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="14,0,0,0"
                                                                  ToolTip="开启后每次击杀从勾选的音效里随机抽一个；关掉就用列表中选中的那个"
                                                                  Checked="KillSoundRandomCheckBox_Changed"
                                                                  Unchecked="KillSoundRandomCheckBox_Changed"/>
                                                        <TextBlock Grid.Column="4"
                                                                   Margin="12,0,0,0"
                                                                   Text="连杀时上一声不会被掐断，会叠着响"
                                                                   Style="{StaticResource HintStyle}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                    <TextBlock x:Name="KillSoundStatusText"
                                                               Style="{StaticResource HintStyle}"
                                                               Margin="0,10,0,0"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                            </StackPanel>
                        </ScrollViewer>



                          <!-- ========== 面板 10：调试后台 ========== -->
                        <ScrollViewer x:Name="DebugPanel"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsChecked, ElementName=NavDebug, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="22,22,24,30">
                                <Grid Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="调试后台" Style="{StaticResource PanelTitleStyle}"/>
                                        <TextBlock Text="查看解码后的聊天原始行与 HEX，便于排查乱码" Style="{StaticResource PanelDescStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <CheckBox x:Name="EnableDebugLogCheckBox"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Checked="EnableDebugLogCheckBox_Changed"
                                                  Unchecked="EnableDebugLogCheckBox_Changed">
                                            <StackPanel>
                                                <TextBlock Text="启用后端日志" FontSize="15" FontWeight="ExtraBold"/>
                                                <TextBlock Text="仅调试用，普通使用可以关闭" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </CheckBox>

                                        <StackPanel x:Name="DebugLogGroup" Visibility="Collapsed" Margin="0,18,0,0">
                                            <Grid Margin="0,0,0,11">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Content="复制日志" Click="CopyDebugLogButton_Click" Style="{StaticResource SmallButtonStyle}" Margin="0,0,8,0"/>
                                                <Button Grid.Column="1" Content="清空日志" Click="ClearDebugLogButton_Click" Style="{StaticResource SmallGhostButtonStyle}"/>
                                                <TextBlock x:Name="DebugLogCountText"
                                                           Grid.Column="3"
                                                           Text="共 0 行"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource HintStyle}"/>
                                            </Grid>
                                            <TextBox x:Name="DebugLogTextBox"
                                                     Style="{StaticResource ConsoleTextBoxStyle}"
                                                     IsReadOnly="True"
                                                     Height="196"/>
                                            <Grid Margin="0,15,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="发送到悬浮窗" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBox x:Name="ManualMessageTextBox" Grid.Column="1" MinWidth="180" Margin="0,0,9,0"/>
                                                <Button Grid.Column="2" Content="发送" Click="SendManualMessageButton_Click" Style="{StaticResource SmallPrimaryButtonStyle}"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- B站弹幕连接状态（不受「启用后端日志」开关影响） -->
                                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="B站弹幕连接状态" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="连接、断开、房间信息与收到的弹幕/通知都会记录在这里" Style="{StaticResource CardDescStyle}" Margin="0,3,0,11"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                                            <Ellipse x:Name="BiliConnDot" Width="7" Height="7"
                                                     Fill="{DynamicResource TextTertiaryBrush}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock x:Name="BiliConnStatusText"
                                                       Text="未连接"
                                                       Margin="8,0,0,0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="复制日志" Click="BiliCopyLogButton_Click" Style="{StaticResource SmallButtonStyle}" Margin="0,0,8,0"/>
                                            <Button Grid.Column="1" Content="清空日志" Click="BiliClearLogButton_Click" Style="{StaticResource SmallGhostButtonStyle}"/>
                                            <TextBlock x:Name="BiliLogCountText"
                                                       Grid.Column="3"
                                                       Text="共 0 行"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource HintStyle}"/>
                                        </Grid>
                                        <TextBox x:Name="BiliLogTextBox"
                                                 Style="{StaticResource ConsoleTextBoxStyle}"
                                                 IsReadOnly="True"
                                                 Height="196"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer x:Name="PluginsPanel"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsChecked, ElementName=NavPlugins, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="22,22,24,30">
                                <StackPanel x:Name="PluginsListView">
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="插件" Style="{StaticResource PanelTitleStyle}"/>
                                        <TextBlock Text="插件是独立的小程序包（zip，里面是 dll + plugin.json）。装好后出现在下面，点卡片进去就是它自己的页面。" Style="{StaticResource PanelDescStyle}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button x:Name="PluginMarketButton" Content="插件市场" ToolTip="从仓库里的清单浏览并安装插件（市场就是你的 GitHub 仓库）" Style="{StaticResource SmallButtonStyle}" Click="PluginMarketButton_Click" Margin="0,0,8,0"/>
                                        <Button x:Name="PluginImportButton" Content="添加插件" ToolTip="选一个插件包（zip）装上，也可以直接把 zip 拖到这一页" Style="{StaticResource SmallPrimaryButtonStyle}" Click="PluginImportButton_Click" Margin="0,0,8,0"/>
                                        <Button x:Name="PluginOpenFolderButton" Content="打开插件目录" ToolTip="打开导入安装的插件所在的目录" Style="{StaticResource SmallButtonStyle}" Click="PluginOpenFolderButton_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="PluginsRootText" Style="{StaticResource HintStyle}" Margin="0,0,0,14" TextWrapping="Wrap"/>
                                <!--
                                    卸载入口就摆在卡片上：上一版把它收进右键菜单，结果就是
                                    "功能明明有、但没人找得到"。同一个操作在详情页头部还有一个入口。
                                -->
                                <TextBlock Style="{StaticResource HintStyle}" Margin="0,0,0,14" TextWrapping="Wrap"
                                           Text="想删插件？点卡片右侧的【卸载】—— 插件目录和它自己的配置目录会一起删掉。右键卡片还能进入插件页面 / 打开目录。"/>

                                <TextBlock x:Name="PluginsEmptyText" Text="还没有装任何插件。点右上角【添加插件】选一个 zip，或者直接把 zip 拖到这一页。" Style="{StaticResource CardDescStyle}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                <UniformGrid x:Name="PluginsListPanel" Columns="2"/>

                                <Button x:Name="PluginRescanButton" Content="重新扫描插件目录" ToolTip="手动往插件目录里放了文件夹？点这里重新扫一遍" Style="{StaticResource SmallGhostButtonStyle}" Click="PluginRescanButton_Click" HorizontalAlignment="Left" Margin="0,4,0,0"/>

                                <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="想自己写一个插件？" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="插件就是普通的 C# 类库：引一下契约程序集，实现 IPlugin，编译出 dll，配上 plugin.json 打成 zip 就能发人。页面不用自己画 —— 把字段（开关 / 滑块 / 下拉 / 按钮）交给宿主，宿主用现有主题渲染，所以插件页面看起来和内置页面一个样。" Style="{StaticResource CardDescStyle}" Margin="0,3,0,10" TextWrapping="Wrap"/>
                                        <TextBlock Style="{StaticResource HintStyle}" TextWrapping="Wrap"
                                                   Text="接口说明、plugin.json 字段表、表单式与自绘页面怎么写、怎么打包发布 —— 都在在线文档里。"/>
                                        <Button x:Name="PluginDevDocButton" Content="打开插件开发文档"
                                                ToolTip="https://goldiamond1031.github.io/MCO"
                                                Style="{StaticResource SmallPrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                                Click="PluginDevDocButton_Click"/>
                                        <TextBlock Style="{StaticResource HintStyle}" Margin="0,6,0,0" TextWrapping="Wrap" Text="提醒：插件跑在本程序里，权限和本程序一样。只装你信任来源的插件包。"/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                                <!-- 单个插件的主页面（点插件卡片进来，返回按钮回列表） -->
                                <StackPanel x:Name="PluginDetailView" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="PluginBackButton" Content="← 返回插件列表" HorizontalAlignment="Left"
                                                Style="{StaticResource SmallGhostButtonStyle}" Click="PluginBackButton_Click"/>
                                        <!--
                                            卸载的第二个入口：进来看过之后觉得不合适，不用退出去找卡片。
                                            和卡片上那个按钮走同一个确认框（UninstallPlugin），行为完全一致。
                                        -->
                                        <Button x:Name="PluginDetailUninstallButton" Grid.Column="1"
                                                Content="卸载这个插件"
                                                ToolTip="把这个插件从本机删掉：插件目录和它自己的配置目录会一起删"
                                                Style="{StaticResource SmallDangerButtonStyle}"
                                                Click="PluginDetailUninstallButton_Click"/>
                                    </Grid>
                                    <StackPanel x:Name="PluginDetailContent"/>
                                </StackPanel>

                                <StackPanel x:Name="PluginMarketView" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="插件市场" Style="{StaticResource PanelTitleStyle}"/>
                                            <TextBlock x:Name="PluginMarketStatusText" Style="{StaticResource HintStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button x:Name="PluginMarketRefreshButton" Content="刷新" ToolTip="重新拉一次清单" Style="{StaticResource SmallPrimaryButtonStyle}" Click="PluginMarketRefreshButton_Click" Margin="0,0,8,0"/>
                                            <Button x:Name="PluginMarketBackButton" Content="← 返回插件列表" Style="{StaticResource SmallGhostButtonStyle}" Click="PluginMarketBackButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBox x:Name="PluginMarketSearchBox" Height="32" Padding="12,0" Margin="0,0,0,14" VerticalContentAlignment="Center"
                                             ToolTip="按名字 / id / 作者 / 标签搜" TextChanged="PluginMarketSearchBox_TextChanged"/>
                                    <TextBlock x:Name="PluginMarketEmptyText" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <UniformGrid x:Name="PluginMarketListPanel" Columns="2"/>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                                        <StackPanel>
                                            <TextBlock Text="市场源" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" Margin="0,3,0,10"
                                                       Text="放插件清单（index.json）的地址。默认走 jsDelivr 镜像，国内一般能通；它拿不到会自动试 GitHub 官方 raw。想换镜像 / 换分支 / 换仓库，改这里就行。"/>
                                            <TextBox x:Name="PluginMarketUrlTextBox" Height="32" Padding="12,0" VerticalContentAlignment="Center"
                                                     FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button x:Name="PluginMarketUrlSaveButton" Content="保存并刷新" Style="{StaticResource SmallButtonStyle}" Click="PluginMarketUrlSaveButton_Click" Margin="0,0,8,0"/>
                                                <Button x:Name="PluginMarketUrlResetButton" Content="恢复默认地址" Style="{StaticResource SmallGhostButtonStyle}" Click="PluginMarketUrlResetButton_Click"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource HintStyle}" TextWrapping="Wrap" Margin="0,12,0,0"
                                                       Text="市场没有服务器：清单和插件包都放在你自己的 GitHub 仓库 market/ 目录里。安装插件等于让别人的代码在本程序里跑，只装你信任来源的插件。"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>                            </StackPanel>
                        </ScrollViewer>

                        <!-- ========== 面板 8：关于 ========== -->
                        <ScrollViewer x:Name="AboutPanel"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsChecked, ElementName=NavAbout, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="22,22,24,30">
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="关于" Style="{StaticResource PanelTitleStyle}"/>
                                        <TextBlock Text="开源声明、打赏，以及要感谢的人" Style="{StaticResource PanelDescStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button x:Name="AboutRefreshButton" Content="刷新名单" ToolTip="重新从 GitHub 拉一遍鸣谢名单"
                                                Style="{StaticResource SmallButtonStyle}" Click="AboutRefreshButton_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 开源声明 + 打赏：左边正文，右边二维码（不套框、不写图注） -->
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="本软件与打赏" Style="{StaticResource CardTitleStyle}"/>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Top">
                                                <TextBlock Style="{StaticResource BodyTextStyle}"
                                                           Text="本软件完全开源免费，源码在 GitHub 上。如果你是通过付费获得本软件的，说明你被骗了——请立即退款，并向原作者举报卖家。"/>
                                                <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,12,0,0"
                                                           Text="如果觉得这个软件帮到了你，可以给gd赏杯奶茶，哪怕gd其实肠胃不好不能喝奶茶("/>
                                                <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,12,0,0"
                                                           Text="这里的打赏一样算进直播时组队优先的打赏榜中，不要忘了备注自己的游戏ID噢，也可以备注一句话，会显示在鸣谢名单上噢"/>
                                            </StackPanel>

                                            <Image Grid.Column="1"
                                                   Source="/res/reward_qrcode.png"
                                                   Width="240" Height="240"
                                                   Stretch="Uniform"
                                                   VerticalAlignment="Top"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                            <Button Content="我的 B 站主页"
                                                    ToolTip="https://space.bilibili.com/586937256"
                                                    Tag="https://space.bilibili.com/586937256"
                                                    Style="{StaticResource SmallButtonStyle}"
                                                    Click="AboutOpenLink_Click"
                                                    Margin="0,0,8,0"/>
                                            <Button Content="QQ 闲聊群"
                                                    ToolTip="https://qm.qq.com/q/yQN8DLlhHG"
                                                    Tag="https://qm.qq.com/q/yQN8DLlhHG"
                                                    Style="{StaticResource SmallButtonStyle}"
                                                    Click="AboutOpenLink_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 打赏鸣谢 -->
                                <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="打赏鸣谢" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="感谢这些朋友的支持（名单来自 GitHub 仓库，点右上角【刷新名单】更新）" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" Margin="0,3,0,8"/>
                                        <TextBlock x:Name="AboutRewardsStatusText" Style="{StaticResource HintStyle}" TextWrapping="Wrap"/>
                                        <StackPanel x:Name="AboutRewardsList" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="AboutRewardsEmptyText" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>

                                <!-- 插件开发鸣谢 -->
                                <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="插件开发鸣谢" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="感谢这些开发者给MCO的插件生态做出的贡献！" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" Margin="0,3,0,8"/>
                                        <TextBlock x:Name="AboutDevsStatusText" Style="{StaticResource HintStyle}" TextWrapping="Wrap"/>
                                        <StackPanel x:Name="AboutDevsList" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="AboutDevsEmptyText" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 状态栏 -->
                    <Border x:Name="StatusBarBorder"
                            Grid.Row="2"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="18,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusTextBlock"
                                           Text="未开始监听"
                                           Margin="10,0,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="CialloButton"
                                    Grid.Column="1"
                                    Width="88"
                                    Height="30"
                                    Padding="0"
                                    Content="Ciallo~"
                                    Click="CialloButton_Click"
                                    Style="{StaticResource SmallPrimaryButtonStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Toast 容器 -->
                    <StackPanel x:Name="ToastHost"
                                Grid.Row="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,22,22"
                                IsHitTestVisible="False"/>
                </Grid>
            </Grid>
            </DockPanel>

            <!-- Ciallo 全窗口弹出层：位于界面最上层，动画期间鼠标穿透 -->
            <Grid x:Name="CialloOverlay"
                  Panel.ZIndex="100"
                  Visibility="Collapsed"
                  Opacity="0.98"
                  ClipToBounds="True"
                  IsHitTestVisible="False">
                <Image x:Name="CialloImage"
                       Stretch="UniformToFill"
                       RenderTransformOrigin="0,0"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="CialloScale" ScaleX="0" ScaleY="1"/>
                    </Image.RenderTransform>
                </Image>
            </Grid>
        </Grid>
    </Border>
</Window>
