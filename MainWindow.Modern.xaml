                                                                   FontSize="11.5"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Text="规则框空着，软件一条击杀都认不出来 —— 画面效果和提示音都不会响。不会写就点右边那个按钮。"/>
                                                    </StackPanel>
