                                                    Margin="0,16,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="KillFeedbackRuleHintIcon"
                                                               Text="!"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,9,0"
                                                               Foreground="{DynamicResource ConsoleWarnBrush}"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock x:Name="KillFeedbackRuleHintTitle"
                                                                   FontSize="12.5"
                                                                   FontWeight="ExtraBold"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource ConsoleWarnBrush}"
                                                                   Text="必须填了匹配规则才会生效"/>
