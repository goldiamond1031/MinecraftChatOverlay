<Window x:Class="MinecraftChatOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Minecraft 聊天悬浮窗 - 配置"
        Height="820"
        Width="1200"
        MinHeight="640"
        MinWidth="1000"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI, PingFang SC, sans-serif"
        WindowStyle="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="22"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MinecraftChatOverlay;component/ModernControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0">
        <Grid>
            <DockPanel>

            <!-- ================= 标题栏 ================= -->
            <Border x:Name="TitleBarBorder"
                    DockPanel.Dock="Top"
                    Height="56"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border Width="38" Height="38" CornerRadius="12" Background="Transparent" ClipToBounds="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
                            </Border.Effect>
                            <Image x:Name="TitleLogoImage"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleTextBlock"
                                       Text="Minecraft Chat Overlay"
                                       FontSize="14.5"
                                       FontWeight="ExtraBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="聊天悬浮窗 · 配置中心"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button x:Name="ThemeToggleButton"
                                Content="☾"
                                Click="ThemeToggleButton_Click"
                                Style="{StaticResource WindowControlButtonStyle}"
                                ToolTip="切换日间 / 夜间模式"/>
                        <Button Content="─"
                                Click="MinimizeButton_Click"
                                Style="{StaticResource WindowControlButtonStyle}"
                                ToolTip="最小化"/>
                        <Button x:Name="MaximizeButton"
                                Content="□"
                                Click="MaximizeButton_Click"
                                Style="{StaticResource WindowControlButtonStyle}"
                                ToolTip="最大化"/>
                        <Button Content="✕"
                                Tag="close"
                                Click="CloseButton_Click"
                                Style="{StaticResource WindowControlButtonStyle}"
                                ToolTip="关闭"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 主体 ================= -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="224"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 侧边栏 -->
                <Border x:Name="SidebarBorder"
                        Grid.Column="0"
                        Background="{DynamicResource SidebarBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <DockPanel LastChildFill="False">
                        <Grid DockPanel.Dock="Top" Margin="10,14,10,0">
                            <Border x:Name="NavIndicator"
                                    Width="3"
                                    Height="24"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Panel.ZIndex="1"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.45" Color="#FF8FBE"/>
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="IndicatorTranslate" Y="0"/>
                                </Border.RenderTransform>
                            </Border>

                            <StackPanel x:Name="NavPanel" Margin="12,0,0,0">
                                <RadioButton x:Name="NavOverlayDisplay"
                                             GroupName="MainNav"
                                             Style="{StaticResource NavRadioButtonStyle}"
                                             Content="悬浮窗显示"
                                             IsChecked="True"
                                             Checked="NavRadioButton_Checked"/>
                                <RadioButton x:Name="NavTextRules"
                                             GroupName="MainNav"
                                             Style="{StaticResource NavRadioButtonStyle}"
                                             Content="文本渲染规则"
                                             Checked="NavRadioButton_Checked"/>

                                <RadioButton x:Name="NavBili"
                                             GroupName="MainNav"
                                             Style="{StaticResource NavRadioButtonStyle}"
                                             Content="B站弹幕"
                                             Checked="NavRadioButton_Checked"/>
                                <RadioButton x:Name="NavMotionBlur"
                                             GroupName="MainNav"
                                             Style="{StaticResource NavRadioButtonStyle}"
                                             Content="游戏动态模糊"
                                             Checked="NavRadioButton_Checked"/>
                                <RadioButton x:Name="NavKillFeed"
                                             GroupName="MainNav"
                                             Style="{StaticResource NavRadioButtonStyle}"
                                             Content="击杀反馈"
                                             Checked="NavRadioButton_Checked"/>

                                <RadioButton x:Name="NavPlugins"
                                             GroupName="MainNav"
                                             Style="{StaticResource NavRadioButtonStyle}"
                                             Content="插件"
                                             Checked="NavRadioButton_Checked"/>
                                <RadioButton x:Name="NavDebug"
                                             GroupName="MainNav"
                                             Style="{StaticResource NavRadioButtonStyle}"
                                             Content="调试后台"
                                             Checked="NavRadioButton_Checked"/>
                                <RadioButton x:Name="NavAbout"
                                             GroupName="MainNav"
                                             Style="{StaticResource NavRadioButtonStyle}"
                                             Content="关于"
                                             Checked="NavRadioButton_Checked"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel DockPanel.Dock="Bottom" Margin="12,10,12,14">
                            <Border Background="{DynamicResource Surface2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12,10">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="MiniStatusDot"
                                             Width="7" Height="7"
                                             Fill="{DynamicResource TextTertiaryBrush}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MiniStatusText"
                                               Text="未连接"
                                               Margin="8,0,0,0"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <!-- 应用名一行；版本号 + 检查更新一行（侧边栏只有 224px，一行塞不下更长的内容） -->
                            <TextBlock Text="Minecraft Chat Overlay"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       HorizontalAlignment="Left"
                                       Margin="2,10,0,0"/>
                            <Grid Margin="2,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AppVersionText"
                                           Text="v1.0.4"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <!-- 有新版时亮起的小红点 -->
                                    <Ellipse x:Name="UpdateDot"
                                             Width="7" Height="7"
                                             Fill="#FF4D4F"
                                             VerticalAlignment="Center"
                                             Margin="0,0,5,0"
                                             Visibility="Collapsed"/>
                                    <Button x:Name="CheckUpdateButton"
                                            Content="检查更新"
                                            Click="CheckUpdateButton_Click"
                                            Style="{StaticResource SmallGhostButtonStyle}"
                                            Height="22"
                                            MinWidth="0"
                                            Padding="8,0"
                                            FontSize="11"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 主区域 -->
                <Grid x:Name="MainContentGrid" Grid.Column="1" Background="{DynamicResource ContentBgBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 工具栏 -->
                    <Border x:Name="ToolbarBorder"
                            Grid.Row="0"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="18,12,18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Height="40" CornerRadius="12" Margin="0,0,14,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=LogPathTextBox}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="Effect" Value="{DynamicResource GlowShadow}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M3,6 L10,6 L12,8 L21,8 L21,18 L3,18 Z"
                                          Stroke="{DynamicResource TextTertiaryBrush}"
                                          StrokeThickness="1.5"
                                          Fill="Transparent"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="13,0,9,0"/>
                                    <TextBox x:Name="LogPathTextBox"
                                             Grid.Column="1"
                                             Style="{StaticResource BareTextBoxStyle}"
                                             FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                                             FontSize="12.5"
                                             VerticalContentAlignment="Center"
                                             Margin="0,0,12,0"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="浏览"
                                        Click="BrowseButton_Click"
                                        Style="{StaticResource SmallButtonStyle}"
                                        Margin="0,0,8,0"/>
                                <Button x:Name="ToggleListenButton"
                                        Content="开始监听"
                                        Click="ToggleListenButton_Click"
                                        Style="{StaticResource SmallPrimaryButtonStyle}"
                                        Margin="0,0,8,0"/>
                                <Button x:Name="ToggleOverlayButton"
                                        Content="隐藏悬浮窗"
                                        Click="ToggleOverlayButton_Click"
                                        Style="{StaticResource SmallButtonStyle}"
                                        Margin="0,0,8,0"/>
                                <Button Content="清空"
                                        Click="ClearButton_Click"
                                        Style="{StaticResource SmallGhostButtonStyle}"
                                        Margin="0,0,8,0"/>
                                <Button x:Name="SaveButton"
                                        Content="保存配置"
                                        Click="SaveButton_Click"
                                        Style="{StaticResource SmallPrimaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 面板内容 -->
                    <Grid Grid.Row="1">
                        <!-- ========== 面板 1：悬浮窗显示 ========== -->
                        <ScrollViewer x:Name="OverlayPanel"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsChecked, ElementName=NavOverlayDisplay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="22,22,24,30">
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="悬浮窗显示" Style="{StaticResource PanelTitleStyle}"/>
                                        <TextBlock Text="调整游戏内聊天悬浮窗的外观与行为" Style="{StaticResource PanelDescStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="重置位置" Click="ResetOverlayPositionButton_Click"
                                                Style="{StaticResource SmallButtonStyle}"
                                                Margin="0,0,8,0"/>
                                        <Button Content="恢复默认" Click="ResetOverlayButton_Click"
                                                Style="{StaticResource SmallButtonStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel>
                                    <!-- 尺寸与布局 -->
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="尺寸与布局" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock Text="控制悬浮窗大小、透明度与消息容量" Style="{StaticResource CardDescStyle}" Margin="0,3,0,18"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Margin="0,0,9,16">
                                                    <TextBlock Text="悬浮窗最大宽度" Style="{StaticResource FieldLabelStyle}"/>
                                                    <Grid>
                                                        <TextBox x:Name="OverlayWidthTextBox" Padding="12,0,42,0"/>
                                                        <TextBlock Text="px" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" IsHitTestVisible="False"/>
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="9,0,0,16">
                                                    <TextBlock Text="悬浮窗最大高度" Style="{StaticResource FieldLabelStyle}"/>
                                                    <Grid>
                                                        <TextBox x:Name="OverlayMaxHeightTextBox" Padding="12,0,42,0"/>
                                                        <TextBlock Text="px" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" IsHitTestVisible="False"/>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Margin="0,0,9,16">
                                                    <TextBlock Text="多少字符换行" Style="{StaticResource FieldLabelStyle}"/>
                                                    <Grid>
                                                        <TextBox x:Name="WrapLengthTextBox" Padding="12,0,52,0"/>
                                                        <TextBlock Text="字符" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" IsHitTestVisible="False"/>
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="9,0,0,16">
                                                    <TextBlock Text="最多保留消息数" Style="{StaticResource FieldLabelStyle}"/>
                                                    <Grid>
                                                        <TextBox x:Name="MaxMessagesTextBox" Padding="12,0,42,0"/>
                                                        <TextBlock Text="条" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" IsHitTestVisible="False"/>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,16">
                                                    <TextBlock Text="悬浮窗不透明度" Style="{StaticResource FieldLabelStyle}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="54"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1" Value="0.9"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}"
                                                                   FontSize="12.5" FontWeight="ExtraBold" Foreground="{DynamicResource PrimaryBrush}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                                                    <TextBlock Text="背景不透明度" Style="{StaticResource FieldLabelStyle}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="54"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Slider x:Name="BackgroundOpacitySlider" Minimum="0" Maximum="1" Value="1"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Value, ElementName=BackgroundOpacitySlider, StringFormat={}{0:P0}}"
                                                                   FontSize="12.5" FontWeight="ExtraBold" Foreground="{DynamicResource PrimaryBrush}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 字体与配色 -->
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="字体与配色" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock Text="选择字体、字号与各类文字颜色" Style="{StaticResource CardDescStyle}" Margin="0,3,0,18"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Margin="0,0,9,16">
                                                    <TextBlock Text="字体" Style="{StaticResource FieldLabelStyle}"/>
                                                    <ComboBox x:Name="FontFamilyComboBox" Loaded="ComboBox_Loaded"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="9,0,0,16">
                                                    <TextBlock Text="字体大小" Style="{StaticResource FieldLabelStyle}"/>
                                                    <Grid>
                                                        <TextBox x:Name="FontSizeTextBox" Padding="12,0,42,0"/>
                                                        <TextBlock Text="px" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" IsHitTestVisible="False"/>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Margin="0,0,9,16">
                                                    <TextBlock Text="字体粗细" Style="{StaticResource FieldLabelStyle}"/>
                                                    <ComboBox x:Name="FontWeightComboBox" IsEditable="False" Loaded="ComboBox_Loaded"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="9,0,0,16">
                                                    <TextBlock Text="日志编码" Style="{StaticResource FieldLabelStyle}"/>
                                                    <ComboBox x:Name="LogEncodingComboBox" Loaded="ComboBox_Loaded"/>
                                                </StackPanel>

                                                <StackPanel x:Name="TextColorRow" Grid.Row="2" Margin="0,0,9,16">
                                                    <TextBlock Text="文字颜色" Style="{StaticResource FieldLabelStyle}"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border x:Name="TextColorPreview" Width="40" Height="40" CornerRadius="12"
                                                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="2"
                                                                Background="White"/>
                                                        <TextBlock x:Name="TextColorHexText" Text="#FFFFFF" Margin="10,0,10,0"
                                                                   FontFamily="Consolas" FontSize="11.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                        <Button Content="选择" Click="TextColorButton_Click" Style="{StaticResource SmallGhostButtonStyle}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel x:Name="BackgroundColorRow" Grid.Row="2" Grid.Column="1" Margin="9,0,0,16">
                                                    <TextBlock Text="背景颜色" Style="{StaticResource FieldLabelStyle}"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border x:Name="BackgroundColorPreview" Width="40" Height="40" CornerRadius="12"
                                                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="2"
                                                                Background="#0A0912"/>
                                                        <TextBlock x:Name="BackgroundColorHexText" Text="#0A0912" Margin="10,0,10,0"
                                                                   FontFamily="Consolas" FontSize="11.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                        <Button Content="选择" Click="BackgroundColorButton_Click" Style="{StaticResource SmallGhostButtonStyle}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel x:Name="PlayerContentColorRow" Grid.Row="3" Margin="0,0,9,16">
                                                    <TextBlock Text="玩家发言颜色" Style="{StaticResource FieldLabelStyle}"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border x:Name="PlayerContentColorPreview" Width="40" Height="40" CornerRadius="12"
                                                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="2"
                                                                Background="#BFE9FF"/>
                                                        <TextBlock x:Name="PlayerContentColorHexText" Text="#BFE9FF" Margin="10,0,10,0"
                                                                   FontFamily="Consolas" FontSize="11.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                        <Button Content="选择" Click="PlayerContentColorButton_Click" Style="{StaticResource SmallGhostButtonStyle}" Margin="0,0,6,0"/>
                                                        <Button Content="清除" Click="ClearPlayerContentColorButton_Click" Style="{StaticResource SmallGhostButtonStyle}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel x:Name="PlayerNameColorRow" Grid.Row="3" Grid.Column="1" Margin="9,0,0,16">
                                                    <TextBlock Text="发言玩家 ID 颜色" Style="{StaticResource FieldLabelStyle}"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border x:Name="PlayerNameColorPreview" Width="40" Height="40" CornerRadius="12"
                                                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="2"
                                                                Background="#FFD166"/>
                                                        <TextBlock x:Name="PlayerNameColorHexText" Text="#FFD166" Margin="10,0,10,0"
                                                                   FontFamily="Consolas" FontSize="11.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                        <Button Content="选择" Click="PlayerNameColorButton_Click" Style="{StaticResource SmallGhostButtonStyle}" Margin="0,0,6,0"/>
                                                        <Button Content="清除" Click="ClearPlayerNameColorButton_Click" Style="{StaticResource SmallGhostButtonStyle}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 行为选项 -->
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="行为选项" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock Text="悬浮窗的交互与显示行为" Style="{StaticResource CardDescStyle}" Margin="0,3,0,18"/>
                                            <UniformGrid Columns="2">
                                                <CheckBox x:Name="ClickThroughCheckBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,8,10">
                                                    <StackPanel>
                                                        <TextBlock Text="点击穿透" FontSize="13" FontWeight="Bold"/>
                                                        <TextBlock Text="开启后鼠标无法拖动 / 点击悬浮窗" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </CheckBox>
                                                <CheckBox x:Name="TopmostCheckBox" Style="{StaticResource ToggleSwitchStyle}" Margin="8,0,0,10" IsChecked="True" IsEnabled="False">
                                                    <StackPanel>
                                                        <TextBlock Text="始终置顶" FontSize="13" FontWeight="Bold"/>
                                                        <TextBlock Text="固定显示在游戏画面上层" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </CheckBox>
                                                <CheckBox x:Name="ShowTimestampCheckBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,8,10">
                                                    <StackPanel>
                                                        <TextBlock Text="显示时间" FontSize="13" FontWeight="Bold"/>
                                                        <TextBlock Text="每条消息前显示本地时间" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </CheckBox>
                                                <CheckBox x:Name="ShadowCheckBox" Style="{StaticResource ToggleSwitchStyle}" Margin="8,0,0,10">
                                                    <StackPanel>
                                                        <TextBlock Text="文字阴影" FontSize="13" FontWeight="Bold"/>
                                                        <TextBlock Text="为文字添加阴影，提升可读性" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </CheckBox>
                                                <CheckBox x:Name="EnableTextSelectionCheckBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,8,0">
                                                    <StackPanel>
                                                        <TextBlock Text="允许选中文本" FontSize="13" FontWeight="Bold"/>
                                                        <TextBlock Text="需先关闭鼠标穿透；选中后按 Ctrl+C 复制" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </CheckBox>
                                                <CheckBox x:Name="MergeDuplicateMessagesCheckBox" Style="{StaticResource ToggleSwitchStyle}" Margin="8,0,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="合并重复消息" FontSize="13" FontWeight="Bold"/>
                                                        <TextBlock Text="合并连续重复消息，避免刷屏" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </CheckBox>
                                                <CheckBox x:Name="EnableMessageAnimationCheckBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,10,8,0">
                                                    <StackPanel>
                                                        <TextBlock Text="新消息动画" FontSize="13" FontWeight="Bold"/>
                                                        <TextBlock Text="新消息使用滑入动画" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </CheckBox>
                                                <CheckBox x:Name="SoundNotifyEnableCheckBox" Style="{StaticResource ToggleSwitchStyle}" Margin="8,10,0,0"
                                                          Checked="SoundNotifyEnableCheckBox_Changed"
                                                          Unchecked="SoundNotifyEnableCheckBox_Changed">
                                                    <StackPanel>
                                                        <TextBlock Text="消息提示音" FontSize="13" FontWeight="Bold"/>
                                                        <TextBlock Text="有玩家说话时播放提示音" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 消息提示音 -->
                                    <Border Style="{StaticResource LockedCardStyle}"
                                            Tag="{Binding IsSoundNotifyCardLocked}"
                                            Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="消息提示音" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock Text="当有玩家说话时就会播放提示音。先在「行为选项」里把它打开，这里才能设置" Style="{StaticResource CardDescStyle}" Margin="0,3,0,18"/>

                                            <StackPanel IsEnabled="{Binding IsChecked, ElementName=SoundNotifyEnableCheckBox}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,9,0">
                                                        <TextBlock Text="最短间隔" Style="{StaticResource FieldLabelStyle}"/>
                                                        <Grid>
                                                            <TextBox x:Name="SoundNotifyIntervalTextBox"
                                                                     Padding="12,0,52,0"
                                                                     MaxLength="5"
                                                                     LostFocus="SoundNotifyIntervalTextBox_LostFocus"/>
                                                            <TextBlock Text="毫秒"
                                                                       FontSize="11.5" FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       Margin="0,0,13,0" IsHitTestVisible="False"/>
                                                        </Grid>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Margin="9,0,0,0"
                                                               Text="这段时间内连着来好几条发言，只响第一次。想每条都响就填 0。"
                                                               Style="{StaticResource HintStyle}"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"/>
                                                </Grid>

                                                <TextBlock Text="提示音" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,7"/>
                                                <ListBox x:Name="SoundChoiceListBox"
                                                         MinHeight="90"
                                                         MaxHeight="190"
                                                         ItemTemplate="{StaticResource SoundChoiceItemTemplate}"
                                                         SelectionChanged="SoundChoiceListBox_SelectionChanged"/>
                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Content="试听" Click="PreviewSoundButton_Click"
                                                            Style="{StaticResource SmallPrimaryButtonStyle}" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="1" Content="添加提示音…" Click="BrowseSoundFileButton_Click"
                                                            Style="{StaticResource SmallGhostButtonStyle}" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="2" Content="移除" Click="RemoveSoundChoiceButton_Click"
                                                            Style="{StaticResource SmallDangerButtonStyle}"/>
                                                    <CheckBox Grid.Column="3"
                                                              x:Name="SoundNotifyRandomCheckBox"
                                                              Content="随机播放"
                                                              Style="{StaticResource InlineToggleStyle}"
                                                              VerticalAlignment="Center"
                                                              Margin="14,0,0,0"
                                                              ToolTip="开启后每次都从勾选的音效里随机抽一个；关掉就用列表中选中的那个"
                                                              Checked="SoundNotifyRandomCheckBox_Changed"
                                                              Unchecked="SoundNotifyRandomCheckBox_Changed"/>
                                                    <TextBlock Grid.Column="4"
                                                               Margin="12,0,0,0"
                                                               Text="「试听」放的是列表里选中的那个"
                                                               Style="{StaticResource HintStyle}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                                <TextBlock x:Name="SoundNotifyStatusText"
                                                           Style="{StaticResource HintStyle}"
                                                           Margin="0,10,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- ========== 面板 2：自动 GG ========== -->


                        <!-- ========== 面板 3：文本渲染规则 ========== -->
                        <ScrollViewer x:Name="RulesPanel"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsChecked, ElementName=NavTextRules, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="22,22,24,30">
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="文本渲染规则" Style="{StaticResource PanelTitleStyle}"/>
                                        <TextBlock Text="让指定文字变色、替换内容，或屏蔽刷屏关键词" Style="{StaticResource PanelDescStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="导出" Click="ExportRulesButton_Click" Style="{StaticResource SmallButtonStyle}" Margin="0,0,8,0"/>
                                        <Button Content="导入" Click="ImportRulesButton_Click" Style="{StaticResource SmallButtonStyle}" Margin="0,0,8,0"/>
                                        <Button Content="正则教程" Click="RegexTutorialButton_Click" Style="{StaticResource SmallGhostButtonStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel>
                                    <!-- 彩色渲染规则 -->
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="彩色渲染规则" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock Text="把指定文字染成指定颜色 / 字重，支持正则与捕获组" Style="{StaticResource CardDescStyle}" Margin="0,3,0,14"/>
                                            <StackPanel x:Name="ColorRuleEditorPanel">
                                            <ListBox x:Name="ColorRuleListBox"
                                                     MinHeight="84"
                                                     MaxHeight="216"
                                                     ItemTemplate="{StaticResource ColorRuleItemTemplate}"
                                                     SelectionChanged="ColorRuleListBox_SelectionChanged"/>
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="ColorRuleTextTextBox" MinWidth="130" Margin="0,0,9,0"/>
                                                <Border x:Name="ColorRuleColorPreview" Grid.Column="1" Width="40" Height="40"
                                                        CornerRadius="12" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="2"
                                                        Background="#FF5C7A" Margin="0,0,6,0"/>
                                                <Button Grid.Column="2" Content="颜色" Click="ChooseColorRuleColorButton_Click" Style="{StaticResource SmallGhostButtonStyle}" Margin="0,0,9,0"/>
                                                <ComboBox x:Name="ColorRuleWeightComboBox" Grid.Column="3" Width="120" Margin="0,0,9,0" Loaded="ComboBox_Loaded"/>
                                                <Button Grid.Column="4" Content="添加" Click="AddColorRuleButton_Click" Style="{StaticResource SmallPrimaryButtonStyle}" Margin="0,0,8,0"/>
                                                <Button Grid.Column="5" Content="更新选中" Click="UpdateColorRuleButton_Click" Style="{StaticResource SmallButtonStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox x:Name="ColorRuleRegexCheckBox" Content="使用正则" Style="{StaticResource InlineToggleStyle}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                <TextBlock Grid.Column="1" Text="高亮第几组" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox x:Name="ColorRuleRegexGroupTextBox" Grid.Column="2" Text="0" Width="70" Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="整句颜色：" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <Border x:Name="ColorRuleMatchColorPreview" Width="34" Height="34" CornerRadius="10"
                                                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="2"
                                                            Background="Transparent" Margin="0,0,8,0"/>
                                                    <Button Content="选择" Click="ChooseColorRuleMatchColorButton_Click" Style="{StaticResource SmallGhostButtonStyle}" Margin="0,0,6,0"/>
                                                    <Button Content="清除" Click="ClearColorRuleMatchColorButton_Click" Style="{StaticResource SmallGhostButtonStyle}"/>
                                                </StackPanel>
                                                <CheckBox x:Name="ColorRuleEnabledCheckBox"
                                                          Grid.Column="4"
                                                          Content="启用此规则"
                                                          Style="{StaticResource InlineToggleStyle}"
                                                          VerticalAlignment="Center"
                                                          Checked="ColorRuleEnabledCheckBox_Changed"
                                                          Unchecked="ColorRuleEnabledCheckBox_Changed"/>
                                            </Grid>
                                            <Button Content="删除选中规则" Click="DeleteColorRuleButton_Click" Style="{StaticResource SmallDangerButtonStyle}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- ID 对应颜色：从聊天里粘进来，一键分配队伍色 -->
                                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ID 对应颜色" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock Text="把玩家列表按「队伍 | 玩家ID」每行一条粘进来，点分配就给这些 ID 染上对应队伍的颜色（游戏里按 TAB 能看到这个列表）"
                                                       Style="{StaticResource CardDescStyle}" Margin="0,3,0,14"/>
                                            <TextBox x:Name="TeamAssignTextBox"
                                                     Height="150"
                                                     AcceptsReturn="True"
                                                     TextWrapping="NoWrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                                                     TextChanged="TeamAssignTextBox_TextChanged"/>
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Content="分配" Click="AssignTeamColorsButton_Click"
                                                        Style="{StaticResource SmallPrimaryButtonStyle}" Margin="0,0,8,0"/>
                                                <Button Grid.Column="1" Content="一键清空" Click="ClearTeamColorsButton_Click"
                                                        Style="{StaticResource SmallGhostButtonStyle}"/>
                                                <TextBlock x:Name="TeamAssignStatusText"
                                                           Grid.Column="2"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Grid>
                                            <TextBlock Text="支持 11 个队：红 / 蓝 / 绿 / 黄 / 青 / 紫 / 粉 / 白 / 黑 / 橙 / 灰队。名字用整词匹配，2B12 不会被 2B1 误染。这些规则在「彩色渲染规则」列表里标着 [队]，一键清空只清它们。"
                                                       Style="{StaticResource HintStyle}" Margin="0,12,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- AI 自动识别：截图目录有新图就发给 AI，自动分配 -->
                                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="AI 自动识别（截图 → 自动分配）" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock Text="开启后，截图目录里一出现新截图就发给 AI 识别，认到的内容会自动填进上面那张卡片并分配队伍色。接口需要支持图片（OpenAI 兼容的 /chat/completions）。"
                                                       Style="{StaticResource CardDescStyle}" Margin="0,3,0,14"/>

                                            <!--
                                                总开关。**它必须一直露着** —— 关着的时候下面那坨详细设置整体收起，
                                                免得一个没用上的功能占掉大半屏。用户想开的时候这里就有入口。
                                            -->
                                            <CheckBox x:Name="AiAutoAssignCheckBox"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      Checked="AiSetting_Changed"
                                                      Unchecked="AiSetting_Changed">
                                                <StackPanel>
                                                    <TextBlock Text="启用自动识别" FontSize="15" FontWeight="ExtraBold"/>
                                                    <TextBlock Text="一有新截图就自动识别并重新分配" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </CheckBox>

                                            <!-- 关着的时候整块收起，只剩上面那个开关 -->
                                            <StackPanel x:Name="AiAutoAssignDetailsPanel"
                                                        Visibility="Collapsed"
                                                        Margin="0,16,0,0">
                                            <TextBlock Text="截图目录" Style="{StaticResource FieldLabelStyle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="AiScreenshotDirTextBox" LostFocus="AiSetting_LostFocus"/>
                                                <Button Grid.Column="1" Content="浏览" Click="BrowseAiScreenshotDirButton_Click"
                                                        Style="{StaticResource SmallButtonStyle}" Margin="8,0,0,0"/>
                                            </Grid>

                                            <StackPanel Margin="0,14,0,0">
                                                <TextBlock Text="接口类型" Style="{StaticResource FieldLabelStyle}"/>
                                                <ComboBox x:Name="AiApiModeComboBox"
                                                          Width="360"
                                                          HorizontalAlignment="Left"
                                                          Loaded="ComboBox_Loaded"
                                                          SelectionChanged="AiApiMode_Changed">
                                                    <ComboBoxItem Content="对话模型 /chat/completions（如 glm-4v-flash、qwen-vl-max）"/>
                                                    <ComboBoxItem Content="智谱 GLM-OCR /layout_parsing（专用 OCR 接口）"/>
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Margin="0,14,0,0">
                                                <TextBlock Text="接口地址 BaseUrl" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="AiBaseUrlTextBox" LostFocus="AiSetting_LostFocus"/>
                                                <TextBlock Text="智谱填 https://open.bigmodel.cn/api/paas/v4（后面会自动接 /chat/completions 或 /layout_parsing）"
                                                           Style="{StaticResource HintStyle}" Margin="0,6,0,0"/>
                                            </StackPanel>

                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,9,0">
                                                    <TextBlock Text="模型 ID（要支持图片）" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBox x:Name="AiModelIdTextBox" LostFocus="AiSetting_LostFocus"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                                    <TextBlock Text="API Key" Style="{StaticResource FieldLabelStyle}"/>
                                                    <PasswordBox x:Name="AiApiKeyBox"
                                                                 Style="{StaticResource ModernPasswordBoxStyle}"
                                                                 LostFocus="AiSetting_LostFocus"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Margin="0,14,0,0">
                                                <TextBlock Text="提示词" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="AiPromptTextBox" Height="54" AcceptsReturn="True" TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto" LostFocus="AiSetting_LostFocus"/>
                                            </StackPanel>

                                            <StackPanel Margin="0,14,0,0">
                                                <TextBlock Text="额外请求参数（JSON，用来关闭思考模式）" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="AiExtraBodyTextBox"
                                                         FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                                                         LostFocus="AiSetting_LostFocus"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Button Content="不设置"
                                                            Click="AiPresetNoExtra_Click"
                                                            Style="{StaticResource SmallGhostButtonStyle}"
                                                            Margin="0,0,8,0"/>
                                                    <Button Content="thinking: disabled"
                                                            Click="AiPresetThinkingDisabled_Click"
                                                            Style="{StaticResource SmallGhostButtonStyle}"
                                                            Margin="0,0,8,0"/>
                                                    <Button Content="enable_thinking: false"
                                                            Click="AiPresetEnableThinkingFalse_Click"
                                                            Style="{StaticResource SmallGhostButtonStyle}"/>
                                                </StackPanel>
                                                <TextBlock Text="各家字段名不一样：智谱/火山用 thinking.type=disabled，通义/硅基流动用 enable_thinking=false。模型把推理过程当正文吐出来时，点对应那个按钮就能关掉。"
                                                           Style="{StaticResource HintStyle}" Margin="0,8,0,0"/>
                                            </StackPanel>

                                            <Border Background="{DynamicResource Surface2Brush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="13"
                                                    Padding="15,13"
                                                    Margin="0,14,0,0">
                                                <StackPanel>
                                                    <CheckBox x:Name="AiCollectIdsCheckBox"
                                                              Style="{StaticResource ToggleSwitchStyle}"
                                                              Checked="AiSetting_Changed"
                                                              Unchecked="AiSetting_Changed">
                                                        <StackPanel>
                                                            <TextBlock Text="用 TAB 补全收集玩家 ID 作参考" FontSize="13" FontWeight="Bold"/>
                                                            <TextBlock Text="TAB 次数是递增的：第 1 个 2 下、第 2 个 3 下、第 3 个 4 下……" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                            <TextBlock Text="会短暂打开聊天栏（几秒）后自动按 Esc 关闭，绝不按回车。收集到的 ID 会拼进提示词，让 AI 从候选里挑，识别率明显提高"
                                                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </CheckBox>

                                                    <Grid Margin="0,14,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,9,0">
                                                            <TextBlock Text="第一个 ID 按几次 TAB" Style="{StaticResource FieldLabelStyle}"/>
                                                            <TextBox x:Name="AiTabFirstTextBox" LostFocus="AiSetting_LostFocus"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="9,0,9,0">
                                                            <TextBlock Text="每往后一个多加几下" Style="{StaticResource FieldLabelStyle}"/>
                                                            <TextBox x:Name="AiTabNextTextBox" LostFocus="AiSetting_LostFocus"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Margin="9,0,9,0">
                                                            <TextBlock Text="按键间隔（毫秒，越小越快）" Style="{StaticResource FieldLabelStyle}"/>
                                                            <TextBox x:Name="AiTabDelayTextBox" LostFocus="AiSetting_LostFocus"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Margin="9,0,0,0">
                                                            <TextBlock Text="最多几轮（防死循环）" Style="{StaticResource FieldLabelStyle}"/>
                                                            <TextBox x:Name="AiTabMaxRoundsTextBox" LostFocus="AiSetting_LostFocus"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                        <Button Content="测试收集 ID（会打开聊天栏）"
                                                                Click="CollectIdsButton_Click"
                                                                Style="{StaticResource SmallGhostButtonStyle}"
                                                                Margin="0,0,8,0"/>
                                                        <Button Content="打开 AI 返回记录"
                                                                Click="OpenAiResponseLogButton_Click"
                                                                Style="{StaticResource SmallGhostButtonStyle}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <CheckBox x:Name="AiCompressImageCheckBox"
                                                      Content="上传前压缩图片（省流量，但小字可能变糊；不勾就是原图直传）"
                                                      Style="{StaticResource InlineToggleStyle}"
                                                      Margin="0,14,0,0"
                                                      Checked="AiSetting_Changed"
                                                      Unchecked="AiSetting_Changed"/>

                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Content="识别最新一张截图" Click="RecognizeLatestScreenshotButton_Click"
                                                        Style="{StaticResource SmallPrimaryButtonStyle}"/>
                                                <TextBlock x:Name="AiStatusText"
                                                           Grid.Column="1"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Grid>

                                            <TextBlock Text="提示：API Key 只保存在本机配置文件里（明文）。识别时整张截图会上传到上面填的这个接口，涉及游戏画面和玩家名单。AI 返回的内容逐行解析，认不出的那一行不会被分配，对应 ID 保持默认颜色。"
                                                       Style="{StaticResource HintStyle}" Margin="0,12,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 文本替换 / 屏蔽 -->
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="文本替换 / 屏蔽" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock Text="支持普通文字与正则，例如 玩家 (.+?) 退出了游戏！ → 玩家 $1 离开了。" Style="{StaticResource CardDescStyle}" Margin="0,3,0,14"/>
                                            <ListBox x:Name="ReplaceRuleListBox"
                                                     MinHeight="74"
                                                     MaxHeight="180"
                                                     ItemTemplate="{StaticResource ReplaceRuleItemTemplate}"
                                                     SelectionChanged="ReplaceRuleListBox_SelectionChanged"/>
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="ReplaceFindTextBox" MinWidth="90" Margin="0,0,9,0"/>
                                                <TextBox x:Name="ReplaceWithTextBox" Grid.Column="1" MinWidth="90" Margin="0,0,9,0"/>
                                                <Button Grid.Column="2" Content="添加" Click="AddReplaceRuleButton_Click" Style="{StaticResource SmallPrimaryButtonStyle}" Margin="0,0,8,0"/>
                                                <Button Grid.Column="3" Content="更新" Click="UpdateReplaceRuleButton_Click" Style="{StaticResource SmallButtonStyle}" Margin="0,0,8,0"/>
                                                <Button Grid.Column="4" Content="删除" Click="DeleteReplaceRuleButton_Click" Style="{StaticResource SmallDangerButtonStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox x:Name="ReplaceRegexCheckBox" Content="使用正则（替换内容可用 $1）" Style="{StaticResource InlineToggleStyle}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                                                <CheckBox x:Name="ReplaceOnlyPlayerContentCheckBox" Grid.Column="1" Content="仅替换玩家发言内容" Style="{StaticResource InlineToggleStyle}" VerticalAlignment="Center"/>
                                                <CheckBox x:Name="ReplaceRuleEnabledCheckBox"
                                                          Grid.Column="3"
                                                          Content="启用此规则"
                                                          Style="{StaticResource InlineToggleStyle}"
                                                          VerticalAlignment="Center"
                                                          Checked="ReplaceRuleEnabledCheckBox_Changed"
                                                          Unchecked="ReplaceRuleEnabledCheckBox_Changed"/>
                                            </Grid>

                                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,18,0,18"/>

                                            <TextBlock Text="屏蔽关键词" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="聊天内容包含以下任意词时不显示，但后端日志仍会输出" Style="{StaticResource HintStyle}" Margin="0,-3,0,12"/>
                                            <ListBox x:Name="BlockKeywordListBox"
                                                     MinHeight="54"
                                                     MaxHeight="150"
                                                     ItemTemplate="{StaticResource BlockKeywordItemTemplate}"
                                                     SelectionChanged="BlockKeywordListBox_SelectionChanged"/>
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="BlockKeywordTextBox" MinWidth="130" Margin="0,0,9,0"/>
                                                <Button Grid.Column="1" Content="添加" Click="AddBlockKeywordButton_Click" Style="{StaticResource SmallPrimaryButtonStyle}" Margin="0,0,8,0"/>
                                                <Button Grid.Column="2" Content="删除选中" Click="DeleteBlockKeywordButton_Click" Style="{StaticResource SmallDangerButtonStyle}"/>
                                            </Grid>
                                            <CheckBox x:Name="BlockKeywordEnabledCheckBox"
                                                      Content="启用此关键词"
                                                      Style="{StaticResource InlineToggleStyle}"
                                                      Margin="0,12,0,0"
                                                      Checked="BlockKeywordEnabledCheckBox_Changed"
                                                      Unchecked="BlockKeywordEnabledCheckBox_Changed"/>
                                            <CheckBox x:Name="BlockKeywordOnlyPlayerContentCheckBox"
                                                      Content="仅玩家发送消息生效"
                                                      Style="{StaticResource InlineToggleStyle}"
                                                      Margin="0,10,0,0"
                                                      Checked="BlockKeywordOnlyPlayerContentCheckBox_Changed"
                                                      Unchecked="BlockKeywordOnlyPlayerContentCheckBox_Changed"/>
                                            <TextBlock Text="勾上后这个词只在玩家发言的内容里生效，系统消息（进服 / 退服 / 成就等）提到它不会被屏蔽"
                                                       Style="{StaticResource HintStyle}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>


                        <!-- ========== 面板 4：玩家查询 ========== -->


                        <!-- ========== 面板 5：B站弹幕 ========== -->
                        <ScrollViewer x:Name="BiliPanel"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsChecked, ElementName=NavBili, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="22,22,24,30">
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="B站弹幕" Style="{StaticResource PanelTitleStyle}"/>
                                        <TextBlock Text="把 B站直播间的弹幕显示在另一个独立弹幕窗里，和游戏聊天互不干扰" Style="{StaticResource PanelDescStyle}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource ChipBorderStyle}" VerticalAlignment="Top">
                                        <TextBlock Text="独立弹幕窗" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </Grid>

                                <StackPanel>
                                    <!-- 连接直播间 -->
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="连接直播间" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock Text="填直播间号或短号，连接成功后弹幕会出现在独立的 B站弹幕窗里" Style="{StaticResource CardDescStyle}" Margin="0,3,0,18"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,9,0">
                                                    <TextBlock Text="直播间号 / 短号" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBox x:Name="BiliRoomIdTextBox"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                    <Button x:Name="BiliToggleConnectButton"
                                                            Content="连接直播间"
                                                            Click="BiliToggleConnectButton_Click"
                                                            Style="{StaticResource SmallPrimaryButtonStyle}"
                                                            Margin="0,0,8,0"/>
                                                    <Button x:Name="BiliToggleOverlayButton"
                                                            Content="显示弹幕窗"
                                                            Click="BiliToggleOverlayButton_Click"
                                                            Style="{StaticResource SmallButtonStyle}"/>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <Button Content="清空弹幕窗" Click="BiliClearOverlayButton_Click" Style="{StaticResource SmallGhostButtonStyle}" Margin="0,0,8,0"/>
                                                <Button Content="重置弹幕窗位置" Click="BiliResetOverlayPositionButton_Click" Style="{StaticResource SmallGhostButtonStyle}"/>
                                            </StackPanel>
                                            <TextBlock Text="连接状态与收到的消息记录在「调试后台」面板里。弹幕区和通知区都不显示滚动条，把鼠标放到对应区域用滚轮就能往上翻看历史，鼠标移开后自动回到最新一条。"
                                                       Style="{StaticResource HintStyle}"
                                                       Margin="0,12,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- B站账号：只保留扫码登录 -->
                                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="B站账号" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock Text="如果不登录就不显示 B站 UID 和完整 ID"
                                                       Style="{StaticResource CardDescStyle}" Margin="0,3,0,18"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="用 B站 App 扫码登录"
                                                        Click="BiliQrLoginButton_Click"
                                                        Style="{StaticResource SmallPrimaryButtonStyle}"/>
                                                <TextBlock x:Name="BiliLoginStatusText"
                                                           Text="未登录"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           FontSize="12"/>
                                            </StackPanel>
                                            <TextBlock Text="登录凭据只保存在本机的 bili.json 里，不会上传到任何服务器。"
                                                       Style="{StaticResource HintStyle}"
                                                       Margin="0,12,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 弹幕窗尺寸与布局 -->
                                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="弹幕窗尺寸与布局" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock Text="控制 B站弹幕窗的大小、透明度与消息容量" Style="{StaticResource CardDescStyle}" Margin="0,3,0,18"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Margin="0,0,9,16">
                                                    <TextBlock Text="弹幕窗宽度" Style="{StaticResource FieldLabelStyle}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Slider x:Name="BiliOverlayWidthSlider" Minimum="320" Maximum="900" Value="440"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Value, ElementName=BiliOverlayWidthSlider, StringFormat={}{0:0}px}"
                                                                   FontSize="12.5" FontWeight="ExtraBold" Foreground="{DynamicResource PrimaryBrush}"
                                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="9,0,0,16">
                                                    <TextBlock Text="弹幕窗高度" Style="{StaticResource FieldLabelStyle}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Slider x:Name="BiliOverlayHeightSlider" Minimum="120" Maximum="1200" Value="620"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Value, ElementName=BiliOverlayHeightSlider, StringFormat={}{0:0}px}"
                                                                   FontSize="12.5" FontWeight="ExtraBold" Foreground="{DynamicResource PrimaryBrush}"
                                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Margin="0,0,9,16">
                                                    <TextBlock Text="整体不透明度" Style="{StaticResource FieldLabelStyle}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Slider x:Name="BiliOpacitySlider" Minimum="0.1" Maximum="1" Value="0.9"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Value, ElementName=BiliOpacitySlider, StringFormat={}{0:P0}}"
                                                                   FontSize="12.5" FontWeight="ExtraBold" Foreground="{DynamicResource PrimaryBrush}"
                                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="9,0,0,16">
                                                    <TextBlock Text="弹幕分行字符数" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBox x:Name="BiliWrapLengthTextBox"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="2" Margin="0,0,9,16">
                                                    <TextBlock Text="最多记录弹幕条数" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBox x:Name="BiliMaxDanmakuTextBox"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="9,0,0,0">
                                                    <TextBlock Text="点击穿透" Style="{StaticResource FieldLabelStyle}"/>
                                                    <CheckBox x:Name="BiliClickThroughCheckBox"
                                                              Style="{StaticResource ToggleSwitchStyle}"
                                                              Checked="BiliImmediate_Changed"
                                                              Unchecked="BiliImmediate_Changed">
                                                        <TextBlock Text="开启后鼠标无法操作弹幕窗" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </CheckBox>
                                                </StackPanel>
                                            </Grid>


                                            <TextBlock Text="顶部显示" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,0"/>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox x:Name="BiliShowRoomTitleCheckBox"
                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                          Checked="BiliImmediate_Changed"
                                                          Unchecked="BiliImmediate_Changed"
                                                          Margin="0,0,18,0">
                                                    <TextBlock Text="房间标题 / 主播" FontSize="13" FontWeight="Bold"/>
                                                </CheckBox>
                                                <CheckBox x:Name="BiliShowOnlineCheckBox"
                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                          Checked="BiliImmediate_Changed"
                                                          Unchecked="BiliImmediate_Changed"
                                                          Margin="0,0,18,0">
                                                    <TextBlock Text="人数" FontSize="13" FontWeight="Bold"/>
                                                </CheckBox>
                                                <CheckBox x:Name="BiliShadowCheckBox"
                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                          Checked="BiliImmediate_Changed"
                                                          Unchecked="BiliImmediate_Changed">
                                                    <TextBlock Text="文字阴影" FontSize="13" FontWeight="Bold"/>
                                                </CheckBox>
                                            </StackPanel>

                                            <StackPanel Margin="0,16,0,0">
                                                <TextBlock Text="顶部数字口径" Style="{StaticResource FieldLabelStyle}"/>
                                                <ComboBox x:Name="BiliOnlineModeComboBox" Width="240" HorizontalAlignment="Left" Loaded="ComboBox_Loaded">
                                                    <ComboBoxItem Content="人气值（官方口径）"/>
                                                    <ComboBoxItem Content="看过人数（累计）"/>
                                                    <ComboBoxItem Content="互动人数"/>
                                                    <ComboBoxItem Content="看过 + 人气"/>
                                                    <ComboBoxItem Content="在线人数（真实）"/>
                                                    <ComboBoxItem Content="在线 + 人气"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 字体：字体族整窗共用，字号按三个区域分开设 -->
                                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="字体" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock Text="字体本身整个弹幕窗共用；字号按顶部、弹幕区、SC 区、礼物区、进场区分别设置" Style="{StaticResource CardDescStyle}" Margin="0,3,0,18"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,16">
                                                    <TextBlock Text="字体" Style="{StaticResource FieldLabelStyle}"/>
                                                    <ComboBox x:Name="BiliFontFamilyComboBox" Width="280" HorizontalAlignment="Left" Loaded="ComboBox_Loaded"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Margin="0,0,9,16">
                                                    <TextBlock Text="顶部字号" Style="{StaticResource FieldLabelStyle}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Slider x:Name="BiliHeaderFontSizeSlider" Minimum="8" Maximum="30" Value="11"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Value, ElementName=BiliHeaderFontSizeSlider, StringFormat={}{0:0}px}"
                                                                   FontSize="12.5" FontWeight="ExtraBold" Foreground="{DynamicResource PrimaryBrush}"
                                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="9,0,0,16">
                                                    <TextBlock Text="弹幕区字号" Style="{StaticResource FieldLabelStyle}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Slider x:Name="BiliFontSizeSlider" Minimum="10" Maximum="30" Value="16"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Value, ElementName=BiliFontSizeSlider, StringFormat={}{0:0}px}"
                                                                   FontSize="12.5" FontWeight="ExtraBold" Foreground="{DynamicResource PrimaryBrush}"
                                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Grid.Row="2" Margin="0,0,9,16">
                                                    <TextBlock Text="SC 区字号" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBox x:Name="BiliSuperChatFontSizeTextBox"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="9,0,0,16">
                                                    <TextBlock Text="礼物区字号" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBox x:Name="BiliGiftFontSizeTextBox"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="3" Margin="0,0,9,0">
                                                    <TextBlock Text="进场区字号" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBox x:Name="BiliEntryFontSizeTextBox"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="9,0,0,0">
                                                    <TextBlock Text="用户名相对弹幕字号" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBox x:Name="BiliNameScaleTextBox"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="弹幕里的用户名默认比正文小一点，比例在右侧调（1 表示和正文一样大）。"
                                                       Style="{StaticResource HintStyle}"
                                                       Margin="0,12,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 颜色 -->
                                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="颜色" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock Text="背景、文字与阴影的颜色。「进场通知颜色」管进场/关注那些，「礼物区文字颜色」管「XX投喂了」这类文字；礼物的名称与金额颜色在下面那张卡片里单独配" Style="{StaticResource CardDescStyle}" Margin="0,3,0,18"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Margin="0,0,9,16">
                                                    <TextBlock Text="背景颜色" Style="{StaticResource FieldLabelStyle}"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border x:Name="BiliBackgroundColorPreview" Width="40" Height="40" CornerRadius="12"
                                                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="2"
                                                                Background="#66000000" Margin="0,0,9,0"/>
                                                        <Button Content="选色" Click="BiliChooseBackgroundColorButton_Click" Style="{StaticResource SmallGhostButtonStyle}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="9,0,0,16">
                                                    <TextBlock Text="背景不透明度" Style="{StaticResource FieldLabelStyle}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Slider x:Name="BiliBackgroundOpacitySlider" Minimum="0" Maximum="1" Value="1"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Value, ElementName=BiliBackgroundOpacitySlider, StringFormat={}{0:P0}}"
                                                                   FontSize="12.5" FontWeight="ExtraBold" Foreground="{DynamicResource PrimaryBrush}"
                                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Margin="0,0,9,16">
                                                    <TextBlock Text="阴影颜色" Style="{StaticResource FieldLabelStyle}"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border x:Name="BiliShadowColorPreview" Width="40" Height="40" CornerRadius="12"
                                                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="2"
                                                                Background="Black" Margin="0,0,9,0"/>
                                                        <Button Content="选色" Click="BiliChooseShadowColorButton_Click" Style="{StaticResource SmallGhostButtonStyle}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="9,0,0,16">
                                                    <TextBlock Text="弹幕文字颜色" Style="{StaticResource FieldLabelStyle}"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border x:Name="BiliDanmakuColorPreview" Width="40" Height="40" CornerRadius="12"
                                                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="2"
                                                                Background="White" Margin="0,0,9,0"/>
                                                        <Button Content="选色" Click="BiliChooseDanmakuColorButton_Click" Style="{StaticResource SmallGhostButtonStyle}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Row="2" Margin="0,0,9,16">
                                                    <TextBlock Text="进场通知颜色" Style="{StaticResource FieldLabelStyle}"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border x:Name="BiliNoticeColorPreview" Width="40" Height="40" CornerRadius="12"
                                                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="2"
                                                                Background="#CCCCCC" Margin="0,0,9,0"/>
                                                        <Button Content="选色" Click="BiliChooseNoticeColorButton_Click" Style="{StaticResource SmallGhostButtonStyle}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="9,0,0,16">
                                                    <TextBlock Text="礼物区文字颜色" Style="{StaticResource FieldLabelStyle}"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border x:Name="BiliGiftTextColorPreview" Width="40" Height="40" CornerRadius="12"
                                                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="2"
                                                                Background="#CCCCCC" Margin="0,0,9,0"/>
                                                        <Button Content="选色" Click="BiliChooseGiftTextColorButton_Click" Style="{StaticResource SmallGhostButtonStyle}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Row="3" Margin="0,0,9,0">
                                                    <TextBlock Text="顶部文字颜色" Style="{StaticResource FieldLabelStyle}"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border x:Name="BiliOnlineColorPreview" Width="40" Height="40" CornerRadius="12"
                                                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="2"
                                                                Background="White" Margin="0,0,9,0"/>
                                                        <Button Content="选色" Click="BiliChooseOnlineColorButton_Click" Style="{StaticResource SmallGhostButtonStyle}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,16,0,0">
                                                    <CheckBox x:Name="BiliDanmakuOriginalColorCheckBox"
                                                              Style="{StaticResource ToggleSwitchStyle}"
                                                              Checked="BiliImmediate_Changed"
                                                              Unchecked="BiliImmediate_Changed">
                                                        <StackPanel>
                                                            <TextBlock Text="显示弹幕自带颜色" FontSize="13" FontWeight="Bold"/>
                                                            <TextBlock Text="开着时 B站彩色弹幕按原色显示；关掉后统一用上面的「弹幕文字颜色」。只影响弹幕区，SC / 礼物 / 舰长走通知区，不受影响。"
                                                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="顶部文字颜色会同时作用于房间标题、主播名和人数。"
                                                       Style="{StaticResource HintStyle}"
                                                       Margin="0,12,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 分区显示：SC / 礼物 / 进场 各自独立成区 -->
                                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="分区显示" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock Text="SC、礼物、进场各自独立成一个区。「最多记录」是保留多少条历史，「最多显示」是同时看到几行 —— 记录比显示多的时候，把鼠标放进对应区域用滚轮就能翻看更早的。进场消息量很大（实测 70 秒 86 条），默认关闭。"
                                                       Style="{StaticResource CardDescStyle}" Margin="0,3,0,18"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Column="1" Text="最多记录" Style="{StaticResource FieldLabelStyle}" Margin="0,0,9,0"/>
                                                <TextBlock Grid.Column="2" Text="最多显示（行）" Style="{StaticResource FieldLabelStyle}"/>

                                                <CheckBox x:Name="BiliSuperChatNoticeCheckBox"
                                                          Grid.Row="1"
                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                          Checked="BiliImmediate_Changed"
                                                          Unchecked="BiliImmediate_Changed"
                                                          Margin="0,0,9,14">
                                                    <TextBlock Text="醒目留言（SC）" FontSize="13" FontWeight="Bold"/>
                                                </CheckBox>
                                                <TextBox x:Name="BiliSuperChatMaxTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,9,14" VerticalAlignment="Center"/>
                                                <TextBox x:Name="BiliSuperChatVisibleTextBox" Grid.Row="1" Grid.Column="2" Margin="0,0,0,14" VerticalAlignment="Center"/>

                                                <StackPanel Grid.Row="2" Margin="0,0,9,14">
                                                    <CheckBox x:Name="BiliGiftNoticeCheckBox"
                                                              Style="{StaticResource ToggleSwitchStyle}"
                                                              Checked="BiliImmediate_Changed"
                                                              Unchecked="BiliImmediate_Changed">
                                                        <TextBlock Text="礼物投喂" FontSize="13" FontWeight="Bold"/>
                                                    </CheckBox>
                                                    <CheckBox x:Name="BiliGuardNoticeCheckBox"
                                                              Style="{StaticResource ToggleSwitchStyle}"
                                                              Checked="BiliImmediate_Changed"
                                                              Unchecked="BiliImmediate_Changed"
                                                              Margin="0,8,0,0">
                                                        <TextBlock Text="大航海（舰长等）" FontSize="13" FontWeight="Bold"/>
                                                    </CheckBox>
                                                </StackPanel>
                                                <TextBox x:Name="BiliGiftMaxTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,9,14" VerticalAlignment="Top"/>
                                                <TextBox x:Name="BiliGiftVisibleTextBox" Grid.Row="2" Grid.Column="2" Margin="0,0,0,14" VerticalAlignment="Top"/>

                                                <CheckBox x:Name="BiliEntryNoticeCheckBox"
                                                          Grid.Row="3"
                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                          Checked="BiliImmediate_Changed"
                                                          Unchecked="BiliImmediate_Changed">
                                                    <TextBlock Text="进场 / 关注 / 分享" FontSize="13" FontWeight="Bold"/>
                                                </CheckBox>
                                                <TextBox x:Name="BiliEntryMaxTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                <TextBox x:Name="BiliEntryVisibleTextBox" Grid.Row="3" Grid.Column="2" Margin="0,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="大航海的提示会显示在礼物区里。弹幕区不受这里影响，它有自己的条数和高度设置。"
                                                       Style="{StaticResource HintStyle}"
                                                       Margin="0,14,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 礼物 / 粉丝牌颜色 -->
                                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="礼物 / 粉丝牌颜色" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock Text="按名称包含匹配（不区分大小写）。礼物名、大航海名、粉丝团灯牌都在这里配色"
                                                       Style="{StaticResource CardDescStyle}" Margin="0,3,0,14"/>
                                            <ListBox x:Name="BiliGiftColorListBox"
                                                     MinHeight="84"
                                                     MaxHeight="240"
                                                     SelectionChanged="BiliGiftColorListBox_SelectionChanged">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="15" Height="15" CornerRadius="5" VerticalAlignment="Center"
                                                                    Background="{Binding Color, Converter={StaticResource HexToBrushConverter}}"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding GiftName}"
                                                                       Margin="10,0,8,0"
                                                                       FontSize="13"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Color}"
                                                                       FontSize="11.5"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="BiliGiftNameTextBox" MinWidth="120" Margin="0,0,9,0"/>
                                                <Border x:Name="BiliGiftColorPreview" Grid.Column="1" Width="40" Height="40"
                                                        CornerRadius="12" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="2"
                                                        Background="#FFFFFF" Margin="0,0,6,0"/>
                                                <Button Grid.Column="2" Content="颜色" Click="BiliChooseGiftColorButton_Click" Style="{StaticResource SmallGhostButtonStyle}" Margin="0,0,9,0"/>
                                                <Button Grid.Column="3" Content="添加" Click="BiliAddGiftColorButton_Click" Style="{StaticResource SmallPrimaryButtonStyle}" Margin="0,0,8,0"/>
                                                <Button Grid.Column="4" Content="更新选中" Click="BiliUpdateGiftColorButton_Click" Style="{StaticResource SmallButtonStyle}" Margin="0,0,8,0"/>
                                                <Button Grid.Column="5" Content="删除选中" Click="BiliRemoveGiftColorButton_Click" Style="{StaticResource SmallDangerButtonStyle}"/>
                                            </Grid>
                                            <TextBlock Text="内置了常见礼物与舰长的默认配色，第一次启动会自动补全；删掉的行不会再被加回来。"
                                                       Style="{StaticResource HintStyle}"
                                                       Margin="0,12,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ========== 面板 6：游戏动态模糊（帧混合） ========== -->
                        <ScrollViewer x:Name="MotionBlurPanel"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsChecked, ElementName=NavMotionBlur, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="22,22,24,30">
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="游戏动态模糊" Style="{StaticResource PanelTitleStyle}"/>
                                        <TextBlock Text="使用帧混合实现动态模糊" Style="{StaticResource PanelDescStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <!--
                                    封禁风险提示：动态模糊是往游戏进程里注入 DLL、直接改画面帧实现的，
                                    这在服务端 / 反作弊眼里属于灰色地带。这一条必须明说，别让用户自己踩了才知道。
                                -->
                                <Border Background="{DynamicResource DangerSoftBrush}"
                                        BorderBrush="{DynamicResource DangerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14,11"
                                        Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="!"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,9,0"
                                                   Foreground="{DynamicResource DangerBrush}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="有封禁风险，用之前请自行斟酌"
                                                       FontSize="12.5"
                                                       FontWeight="ExtraBold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource DangerBrush}"/>
                                            <TextBlock FontSize="11.5"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="动态模糊是靠往游戏进程里注入 DLL、直接改画面帧实现的 —— 这类操作在服务端和反作弊眼里属于灰色地带，有可能被判定成作弊并封号。本身具有封禁记录的机器、以及被人举报，都会进一步加大封禁风险，要不要用请自行斟酌。"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="1. 选择游戏进程" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="列出的是所有带窗口的进程，找到你的 Java 版游戏。注入不用重启游戏，卸载也不用；使用帧混合实现动态模糊，当前支持 OpenGL（Minecraft Java 版）。" Style="{StaticResource CardDescStyle}" Margin="0,3,0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="MotionBlurProcessComboBox"
                                                      Height="34"
                                                      Loaded="ComboBox_Loaded"
                                                      ToolTip="选择要注入的游戏进程"/>
                                            <Button Grid.Column="1"
                                                    Content="刷新列表"
                                                    Click="MotionBlurRefreshButton_Click"
                                                    Style="{StaticResource SmallButtonStyle}"
                                                    Margin="8,0,0,0"/>
                                            <Button Grid.Column="2"
                                                    x:Name="MotionBlurInjectButton"
                                                    Content="注入并接管"
                                                    Click="MotionBlurInjectButton_Click"
                                                    Style="{StaticResource SmallPrimaryButtonStyle}"
                                                    Margin="8,0,0,0"/>
                                        </Grid>
                                        <TextBlock x:Name="MotionBlurStatusText"
                                                   Style="{StaticResource HintStyle}"
                                                   Text="尚未注入"
                                                   Margin="0,12,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="2. 帧混合设置" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="使用帧混合实现动态模糊。强度 = 参与平均的帧数（2~8 帧），权重线性递减并归一化。越大拖影越长，但长度有上限，停下后最多 N 帧就干净了，不会残留长尾。" Style="{StaticResource CardDescStyle}" Margin="0,3,0,16"/>

                                        <CheckBox x:Name="MotionBlurEnableCheckBox"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Checked="MotionBlurEnableCheckBox_Changed"
                                                  Unchecked="MotionBlurEnableCheckBox_Changed">
                                            <StackPanel>
                                                <TextBlock Text="开启帧混合" FontSize="13" FontWeight="Bold"/>
                                                <TextBlock Text="关掉之后游戏立刻回到完全原生的画面（静止画面始终逐像素不变）" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </CheckBox>

                                        <StackPanel Margin="0,16,0,0">
                                            <TextBlock Text="模糊强度" Style="{StaticResource FieldLabelStyle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="MotionBlurStrengthSlider"
                                                        Minimum="0.05"
                                                        Maximum="0.95"
                                                        Value="0.55"
                                                        ValueChanged="MotionBlurStrengthSlider_ValueChanged"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Value, ElementName=MotionBlurStrengthSlider, StringFormat={}{0:P0}}"
                                                           FontSize="12.5" FontWeight="ExtraBold"
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Margin="10,0,0,0"/>
                                            </Grid>
                                        </StackPanel>

                                        <CheckBox x:Name="MotionBlurAutoInjectCheckBox"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Margin="0,16,0,0"
                                                  Checked="MotionBlurAutoInjectCheckBox_Changed"
                                                  Unchecked="MotionBlurAutoInjectCheckBox_Changed">
                                            <StackPanel>
                                                <TextBlock Text="下次启动自动注入这个游戏" FontSize="13" FontWeight="Bold"/>
                                                <TextBlock Text="按记住的进程名找（例如 javaw.exe），找到就自动注入" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </CheckBox>

                                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                            <Button Content="重装钩子" Click="MotionBlurReinstallButton_Click" Style="{StaticResource SmallGhostButtonStyle}" Margin="0,0,8,0"
                                                    ToolTip="DLL 已经在游戏进程里、但 SwapBuffers 钩子丢失时，让 DLL 重新挂钩（不需要重新注入）。"/>
                                            <Button Content="卸载钩子" Click="MotionBlurUnhookButton_Click" Style="{StaticResource SmallGhostButtonStyle}"
                                                    ToolTip="还原游戏原生 SwapBuffers；DLL 仍留在进程里。开/关帧混合只切换效果，不负责装载或卸载钩子。"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                          <!-- ========== 面板 8：区域放大 ========== -->
                          <!-- ========== 面板 9：击杀反馈 ========== -->
                        <ScrollViewer x:Name="KillFeedPanel"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsChecked, ElementName=NavKillFeed, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="22,22,24,30">
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="击杀反馈" Style="{StaticResource PanelTitleStyle}"/>
                                        <TextBlock Text="检测到你的击杀时，在游戏画面上做一次视觉反馈"
                                                   Style="{StaticResource PanelDescStyle}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Style="{StaticResource ChipPrimaryBorderStyle}"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="需要注入" FontSize="11.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryBrush}"/>
                                    </Border>
                                </Grid>

                                <!--
                                    封禁风险提示：击杀反馈的画面效果是走动态模糊那条注入通路送进游戏的，
                                    所以它和动态模糊是同一类风险。这条常驻，不跟着状态变色。
                                -->
                                <Border Background="{DynamicResource DangerSoftBrush}"
                                        BorderBrush="{DynamicResource DangerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14,11"
                                        Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="!"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,9,0"
                                                   Foreground="{DynamicResource DangerBrush}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="只有「画面效果」有封禁风险，图标和提示音没有"
                                                       FontSize="12.5"
                                                       FontWeight="ExtraBold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource DangerBrush}"/>
                                            <TextBlock FontSize="11.5"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="在不注入动态模糊的前提下使用本模块功能不会有封禁风险，同样的，依赖动态模糊的「效果预览」功能无法使用，也就是说，击杀图标和击杀音效不会导致封禁。"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!--
                                    前置条件提示条：击杀反馈的视觉部分是走动态模糊那条注入通路送到游戏里的，
                                    没注入 → 效果根本到不了游戏画面。这行常驻显示，并按实际情况变色，
                                    免得用户开了击杀反馈却发现"没反应"，还得自己猜原因。
                                -->
                                <Border x:Name="KillFeedbackPrereqBanner"
                                        Style="{StaticResource CardStyle}"
                                        Padding="14,11"
                                        Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="KillFeedbackPrereqIcon"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,9,0"
                                                   Foreground="{DynamicResource ConsoleWarnBrush}"
                                                   Text="!"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="KillFeedbackPrereqTitle"
                                                       FontSize="12.5"
                                                       FontWeight="ExtraBold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ConsoleWarnBrush}"
                                                       Text="要先开启动态模糊并注入游戏，击杀反馈才会生效"/>
                                            <TextBlock x:Name="KillFeedbackPrereqDetail"
                                                       FontSize="11.5"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="击杀反馈的画面效果是通过动态模糊的注入通路送进游戏的 —— 没注入，效果到不了游戏画面。到「游戏动态模糊」页选好进程点【注入并接管】就能用。"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <CheckBox x:Name="KillFeedbackEnableCheckBox"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Checked="KillFeedbackEnableCheckBox_Changed"
                                                  Unchecked="KillFeedbackEnableCheckBox_Changed">
                                            <StackPanel>
                                                <TextBlock Text="击杀反馈" FontSize="15" FontWeight="ExtraBold"/>
                                                <TextBlock Text="匹配到你的击杀时做一次反馈。规则由示例消息自动切出来，不用会写正则 —— 只留「你的 ID + 紧挨着的一小段固定词」，不要求出现在行首，一局里有几种格式就写几条"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </CheckBox>

                                        <StackPanel IsEnabled="{Binding IsChecked, ElementName=KillFeedbackEnableCheckBox}"
                                                    Margin="0,18,0,0">
                                            <StackPanel Margin="0,0,0,14">
                                                <TextBlock Text="你自己的 ID（填裸名字，不带称号 / VIP 前缀）" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="KillFeedbackPlayerIdTextBox"
                                                         ToolTip="游戏里你显示成 [vip1][25阶1003⚝]Steve 这种样子时，这里只填 Steve。&#10;称号 / VIP 图标 / 方括号前缀不用你自己删 —— 下面的「剥离方括号前缀」会先剥掉再匹配。&#10;只有把那个勾取消掉，才需要照日志原样连前缀一起填。"
                                                         LostFocus="KillFeedbackRuleInput_LostFocus"/>
                                                <TextBlock Style="{StaticResource HintStyle}" TextWrapping="Wrap" Margin="0,5,0,0" Text="例：日志里写的是 [vip1][25阶1003⚝]Steve 击败了 Alex —— 这里填 Steve 就行，称号和 VIP 前缀不用管。"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,14">
                                                <TextBlock Text="你的击杀消息示例（从日志或悬浮窗复制一条）" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="KillFeedbackSampleTextBox"
                                                         LostFocus="KillFeedbackRuleInput_LostFocus"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="示例里的敌方名字（只当切点用，不写进规则）" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="KillFeedbackSampleEnemyTextBox"
                                                         ToolTip="软件靠它认出消息里哪一段是名字。你的 ID 在前在后都行 —— 敌方名字在前就取它之后那一段，在后就取它之前那一段"
                                                         LostFocus="KillFeedbackRuleInput_LostFocus"/>
                                            </StackPanel>

                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Content="生成并加一行"
                                                        Click="KillFeedbackBuildPatternButton_Click"
                                                        Style="{StaticResource SmallPrimaryButtonStyle}"
                                                        Margin="0,0,14,0"/>
                                                <CheckBox x:Name="KillFeedbackStripCheckBox"
                                                          Grid.Column="1"
                                                          Content="剥离方括号前缀"
                                                          Style="{StaticResource InlineToggleStyle}"
                                                          VerticalAlignment="Center"
                                                          ToolTip="匹配前先把 [vip1] / [25阶1003⚝] / 【称号】 这类装饰剥掉，VIP 图标的私用区字符也一并去掉。不剥的话规则会因为称号一变就失配"
                                                          Checked="KillFeedbackStripCheckBox_Changed"
                                                          Unchecked="KillFeedbackStripCheckBox_Changed"/>
                                                <TextBlock x:Name="KillFeedbackBuildStatusText"
                                                           Grid.Column="2"
                                                           Margin="14,0,0,0"
