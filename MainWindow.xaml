<!-- 旧版界面备份：当前项目实际使用 MainWindow.Modern.xaml + ModernControls.xaml，此文件已被 csproj 排除编译。 -->
<Window x:Class="MinecraftChatOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Minecraft 聊天悬浮窗 - 配置"
        Height="760"
        Width="1000"
        MinHeight="600"
        MinWidth="900"
        Background="#F7F9FC"
        FontFamily="Segoe UI, Microsoft YaHei UI, PingFang SC, sans-serif"
        WindowStyle="None"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 颜色与画刷 -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#6C5CE7"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#7F6FF0"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#5A4BD1"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF7675"/>
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ContentBgBrush" Color="#F7F9FC"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E4E7EC"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2D3436"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#636E72"/>
        <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="HoverBgBrush" Color="#F0F2F5"/>
        <SolidColorBrush x:Key="PressedBgBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="NavHoverBrush" Color="#F5F6FA"/>
        <SolidColorBrush x:Key="SwitchTrackBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="SwitchTrackBorderBrush" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="SwitchThumbBrush" Color="#FFFFFF"/>

        <!-- 专用于 ColorAnimation 的 Color 资源 -->
        <Color x:Key="PrimaryColor">#6C5CE7</Color>

        <!-- 阴影效果 -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
        <DropShadowEffect x:Key="HoverShadow" BlurRadius="16" ShadowDepth="4" Opacity="0.15" Color="#000000"/>

        <!-- 布尔转可见性转换器 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 基础按钮样式 -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter TargetName="border" Property="Effect" Value="{DynamicResource HoverShadow}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="border" Property="Background" Value="Transparent"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.97" Duration="0:0:0.05"/>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.97" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/>
                                <Setter TargetName="border" Property="Effect" Value="{DynamicResource HoverShadow}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.96" Duration="0:0:0.05"/>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.96" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 侧边栏导航按钮样式 -->
        <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="14,10"
                                Margin="5,0,0,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                                <Setter TargetName="border" Property="Effect" Value="{DynamicResource HoverShadow}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="border" Property="Background" Value="Transparent"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 开关按钮样式 -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="44" Height="24" VerticalAlignment="Center">
                                <Border x:Name="track"
                                        Background="{DynamicResource SwitchTrackBrush}"
                                        CornerRadius="12"
                                        BorderBrush="{DynamicResource SwitchTrackBorderBrush}"
                                        BorderThickness="1"/>
                                <Ellipse x:Name="thumb"
                                         Width="18" Height="18"
                                         Fill="{DynamicResource SwitchThumbBrush}"
                                         HorizontalAlignment="Left"
                                         Margin="2,0,0,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.3" Color="#000000"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="thumb"
                                                                Storyboard.TargetProperty="Margin"
                                                                To="22,0,0,0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="thumb"
                                                                Storyboard.TargetProperty="Margin"
                                                                To="2,0,0,0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="Effect" Value="{DynamicResource HoverShadow}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="track" Property="Opacity" Value="0.5"/>
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框样式 -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border"
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        To="#B0B8C4" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border"
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        To="#E4E7EC" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="{StaticResource PrimaryColor}" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#E4E7EC" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片样式 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
        </Style>

        <!-- 分组标题样式 -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- 窗口控制按钮样式 -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PressedBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 可编辑 ComboBox 内部文本框样式 -->
        <Style x:Key="ComboBoxEditableTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ComboBox 下拉项样式 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox 整体样式：重写模板，避免默认模板里写死的日间系统色 -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="MainBorder"
                                    Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>

                            <ToggleButton x:Name="DropDownToggle"
                                          Grid.ColumnSpan="2"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Foreground="{TemplateBinding Foreground}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M 0,0 L 4,4 L 8,0"
                                                  Stroke="{TemplateBinding Foreground}"
                                                  StrokeThickness="1.5"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              Grid.Column="0"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              IsHitTestVisible="False"/>

                            <TextBox x:Name="PART_EditableTextBox"
                                     Grid.Column="0"
                                     Margin="{TemplateBinding Padding}"
                                     Style="{StaticResource ComboBoxEditableTextBoxStyle}"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Visibility="Collapsed"/>

                            <Popup x:Name="PART_Popup"
                                   Grid.ColumnSpan="2"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   StaysOpen="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide"
                                   Focusable="False">
                                <Border x:Name="DropDownBorder"
                                        Background="{DynamicResource CardBgBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer SnapsToDevicePixels="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="False">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 自定义标题栏 -->
        <Border x:Name="TitleBarBorder"
                DockPanel.Dock="Top"
                Height="40"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 标题文字 -->
                <TextBlock x:Name="TitleTextBlock"
           Text="Minecraft Chat Overlay"
           FontSize="16"
           FontWeight="600"
           Foreground="#6C5CE7"
           VerticalAlignment="Center"
           Margin="12,0,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="4"
                                          ShadowDepth="1"
                                          Opacity="0.3"
                                          Color="#000000"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- 窗口控制按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 主题切换按钮 -->
                    <Button x:Name="ThemeToggleButton" 
                            Content="🌙" 
                            Width="40" 
                            Height="30" 
                            Click="ThemeToggleButton_Click" 
                            Style="{StaticResource WindowControlButtonStyle}"
                            ToolTip="切换夜间模式"/>
                    
                    <Button Content="─" Width="40" Height="30" Click="MinimizeButton_Click" Style="{StaticResource WindowControlButtonStyle}"/>
                    <Button x:Name="MaximizeButton" Content="□" Width="40" Height="30" Click="MaximizeButton_Click" Style="{StaticResource WindowControlButtonStyle}"/>
                    <Button Content="✕" Width="40" Height="30" Click="CloseButton_Click" Style="{StaticResource WindowControlButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区域 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧边栏 -->
            <Border x:Name="SidebarBorder"
                    Grid.Column="0"
                    Background="{DynamicResource SidebarBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- 导航区域 -->
                    <Grid DockPanel.Dock="Top" Margin="0,8,0,0">
                        <!-- 独立指示条 -->
                        <Border x:Name="NavIndicator"
                                Width="3"
                                Height="24"
                                Background="#FF7675"
                                CornerRadius="1.5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="4,0,0,0"
                                Panel.ZIndex="1"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="IndicatorTranslate" Y="0"/>
                            </Border.RenderTransform>
                        </Border>

                        <!-- 导航按钮 -->
                        <StackPanel>
                            <RadioButton x:Name="NavOverlayDisplay"
                                         GroupName="MainNav"
                                         Style="{StaticResource NavRadioButtonStyle}"
                                         Content="悬浮窗显示"
                                         IsChecked="True"
                                         Checked="NavRadioButton_Checked"/>
                            <RadioButton x:Name="NavAutoGG"
                                         GroupName="MainNav"
                                         Style="{StaticResource NavRadioButtonStyle}"
                                         Content="自动 GG"
                                         Checked="NavRadioButton_Checked"/>
                            <RadioButton x:Name="NavTextRules"
                                         GroupName="MainNav"
                                         Style="{StaticResource NavRadioButtonStyle}"
                                         Content="文本渲染规则"
                                         Checked="NavRadioButton_Checked"/>
                            <RadioButton x:Name="NavDebug"
                                         GroupName="MainNav"
                                         Style="{StaticResource NavRadioButtonStyle}"
                                         Content="调试后台"
                                         Checked="NavRadioButton_Checked"/>
                        </StackPanel>
                    </Grid>

                    <!-- 底部版本信息 -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="20,16">
                        <TextBlock Text="v1.0.0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 右侧主内容区 -->
            <Grid x:Name="MainContentGrid" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶部全局工具栏 -->
                <Border x:Name="ToolbarBorder"
                        Grid.Row="0"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="日志文件：" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="LogPathTextBox"
                                 Grid.Column="1"
                                 VerticalContentAlignment="Center"
                                 Padding="6,3"
                                 Margin="0,0,6,0"/>
                        <Button Grid.Column="2" Content="浏览..." Width="70" Padding="6,3" Margin="0,0,8,0" Click="BrowseButton_Click"/>
                        <Button x:Name="ToggleListenButton" Grid.Column="3" Content="开始监听" Width="90" Padding="8,4" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" Click="ToggleListenButton_Click"/>
                        <Button x:Name="ToggleOverlayButton" Grid.Column="4" Content="显示悬浮窗" Width="100" Padding="8,4" Margin="0,0,8,0" Click="ToggleOverlayButton_Click"/>
                        <Button Grid.Column="5" Content="清空显示" Width="80" Padding="8,4" Margin="0,0,8,0" Click="ClearButton_Click"/>
                        <Button Grid.Column="6" Content="保存配置" Width="90" Padding="8,4" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click"/>
                    </Grid>
                </Border>

                <!-- 内容区域：四个面板切换 -->
                <Grid Grid.Row="1" Margin="16">
                    <!-- 悬浮窗显示面板 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsChecked, ElementName=NavOverlayDisplay, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="悬浮窗显示设置" Style="{StaticResource SectionTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="悬浮窗最大宽度" Margin="4" VerticalAlignment="Center"/>
                                        <TextBox x:Name="OverlayWidthTextBox" Grid.Column="1" Margin="4" Padding="2" VerticalContentAlignment="Center"/>

                                        <TextBlock Grid.Column="2" Text="悬浮窗不透明度" Margin="8,4,4,4" VerticalAlignment="Center"/>
                                        <Slider x:Name="OpacitySlider" Grid.Column="3" Minimum="0.1" Maximum="1" Value="0.9" Margin="8,4,4,4" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Text="悬浮窗最大长度(高度)" Margin="4" VerticalAlignment="Center"/>
                                        <TextBox x:Name="OverlayMaxHeightTextBox" Grid.Row="1" Grid.Column="1" Margin="4" Padding="2" VerticalContentAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="背景不透明度" Margin="8,4,4,4" VerticalAlignment="Center"/>
                                        <Slider x:Name="BackgroundOpacitySlider" Grid.Row="1" Grid.Column="3" Minimum="0" Maximum="1" Value="1" Margin="8,4,4,4" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="2" Text="多少字符换行" Margin="4" VerticalAlignment="Center"/>
                                        <TextBox x:Name="WrapLengthTextBox" Grid.Row="2" Grid.Column="1" Margin="4" Padding="2" VerticalContentAlignment="Center"/>

                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="最多保留消息数" Margin="8,4,4,4" VerticalAlignment="Center"/>
                                        <TextBox x:Name="MaxMessagesTextBox" Grid.Row="2" Grid.Column="3" Margin="8,4,4,4" Padding="2" VerticalContentAlignment="Center"/>

                                        <TextBlock Grid.Row="3" Text="点击穿透" Margin="4" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="ClickThroughCheckBox" Grid.Row="3" Grid.Column="1" Margin="4" VerticalAlignment="Center"
                                                  Content="开启后鼠标无法拖动/点击悬浮窗" Style="{StaticResource ToggleSwitchStyle}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="始终置顶" Margin="8,4,4,4" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="TopmostCheckBox" Grid.Row="3" Grid.Column="3" Margin="8,4,4,4" VerticalAlignment="Center"
                                                  IsChecked="True" IsEnabled="False" Content="固定置顶" Style="{StaticResource ToggleSwitchStyle}"/>

                                        <TextBlock Grid.Row="4" Text="显示时间" Margin="4" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="ShowTimestampCheckBox" Grid.Row="4" Grid.Column="1" Margin="4" VerticalAlignment="Center"
                                                  Content="每条消息前显示本地时间" Style="{StaticResource ToggleSwitchStyle}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="文字阴影" Margin="8,4,4,4" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="ShadowCheckBox" Grid.Row="4" Grid.Column="3" Margin="8,4,4,4" VerticalAlignment="Center"
                                                  Content="显示文字阴影" Style="{StaticResource ToggleSwitchStyle}"/>

                                        <TextBlock Grid.Row="5" Text="字体" Margin="4" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="FontFamilyComboBox" Grid.Row="5" Grid.Column="1" Margin="4" IsEditable="True" VerticalContentAlignment="Center"/>

                                        <TextBlock Grid.Row="5" Grid.Column="2" Text="字体大小" Margin="8,4,4,4" VerticalAlignment="Center"/>
                                        <TextBox x:Name="FontSizeTextBox" Grid.Row="5" Grid.Column="3" Margin="8,4,4,4" Padding="2" VerticalContentAlignment="Center"/>

                                        <TextBlock Grid.Row="6" Text="字体粗细" Margin="4" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="FontWeightComboBox" Grid.Row="6" Grid.Column="1" Margin="4" IsEditable="False" VerticalContentAlignment="Center"/>

                                        <TextBlock Grid.Row="6" Grid.Column="2" Text="日志编码" Margin="8,4,4,4" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="LogEncodingComboBox" Grid.Row="6" Grid.Column="3" Margin="8,4,4,4" IsEditable="True" VerticalContentAlignment="Center"/>

                                        <TextBlock Grid.Row="7" Text="文字颜色" Margin="4" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="4">
                                            <Border x:Name="TextColorPreview" Width="26" Height="22" BorderBrush="#888888" BorderThickness="1" Background="White" CornerRadius="3" Margin="0,0,6,0"/>
                                            <Button Content="选择颜色..." Width="90" Padding="4,1" Click="TextColorButton_Click"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="7" Grid.Column="2" Text="背景颜色" Margin="8,4,4,4" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="7" Grid.Column="3" Orientation="Horizontal" Margin="8,4,4,4">
                                            <Border x:Name="BackgroundColorPreview" Width="26" Height="22" BorderBrush="#888888" BorderThickness="1" Background="#99000000" CornerRadius="3" Margin="0,0,6,0"/>
                                            <Button Content="选择颜色..." Width="90" Padding="4,1" Click="BackgroundColorButton_Click"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="8" Text="玩家发言颜色" Margin="4" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="4">
                                            <Border x:Name="PlayerContentColorPreview" Width="26" Height="22" BorderBrush="#888888" BorderThickness="1" Background="Transparent" CornerRadius="3" Margin="0,0,6,0"/>
                                            <Button Content="选择颜色..." Width="90" Padding="4,1" Margin="0,0,6,0" Click="PlayerContentColorButton_Click"/>
                                            <Button Content="清除" Width="50" Padding="4,1" Click="ClearPlayerContentColorButton_Click"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="8" Grid.Column="2" Text="发言玩家ID颜色" Margin="8,4,4,4" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="8" Grid.Column="3" Orientation="Horizontal" Margin="8,4,4,4">
                                            <Border x:Name="PlayerNameColorPreview" Width="26" Height="22" BorderBrush="#888888" BorderThickness="1" Background="Transparent" CornerRadius="3" Margin="0,0,6,0"/>
                                            <Button Content="选择颜色..." Width="90" Padding="4,1" Margin="0,0,6,0" Click="PlayerNameColorButton_Click"/>
                                            <Button Content="清除" Width="50" Padding="4,1" Click="ClearPlayerNameColorButton_Click"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="9" Text="文本选择" Margin="4" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="EnableTextSelectionCheckBox"
                                                  Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3"
                                                  Margin="4" VerticalAlignment="Center"
                                                  Content="允许选中悬浮窗文本进行复制（需要关闭鼠标穿透）"
                                                  Style="{StaticResource ToggleSwitchStyle}"/>

                                        <TextBlock Grid.Row="10" Text="合并重复消息" Margin="4" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="MergeDuplicateMessagesCheckBox"
                                                  Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="3"
                                                  Margin="4" VerticalAlignment="Center"
                                                  Content="合并连续重复消息，避免有人刷屏"
                                                  Style="{StaticResource ToggleSwitchStyle}"/>

                                        <TextBlock Grid.Row="11" Text="消息动画" Margin="4" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="EnableMessageAnimationCheckBox"
                                                  Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="3"
                                                  Margin="4" VerticalAlignment="Center"
                                                  Content="新消息显示时使用滑入动画"
                                                  Style="{StaticResource ToggleSwitchStyle}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 自动GG面板 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsChecked, ElementName=NavAutoGG, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="自动 GG 设置" Style="{StaticResource SectionTitleStyle}"/>
                                    <CheckBox x:Name="EnableAutoGgCheckBox"
                                              Content="启用自动 GG：检测到胜利消息后自动打开聊天栏并发送 gg"
                                              Margin="0,0,0,6"
                                              Style="{StaticResource ToggleSwitchStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="触发正则" VerticalAlignment="Center" Margin="0,4,6,4"/>
                                        <TextBox x:Name="AutoGgTriggerTextBox" Grid.Column="1" Margin="0,4" Padding="2" Text="恭喜! .+? 获得胜利!"/>

                                        <TextBlock Grid.Column="2" Text="打开聊天栏按键" VerticalAlignment="Center" Margin="8,4,6,4"/>
                                        <TextBox x:Name="AutoGgChatKeyTextBox" Grid.Column="3" Margin="0,4" Padding="2" Text="t"/>

                                        <TextBlock Grid.Row="1" Text="自动发送文字" VerticalAlignment="Center" Margin="0,4,6,4"/>
                                        <TextBox x:Name="AutoGgTextTextBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Padding="2" Text="gg"/>
                                    </Grid>
                                    <CheckBox x:Name="AutoGgUseClipboardCheckBox"
                                              Content="使用剪贴板粘贴方式发送（推荐，可避免中文输入法导致字母被吞/回车不发送）"
                                              Margin="0,4,0,4"
                                              Style="{StaticResource ToggleSwitchStyle}"/>
                                    <TextBlock Text="注意：触发时需要 Minecraft 窗口处于前台，程序会模拟按键。请先在小游戏/测试环境验证。"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 文本渲染规则面板 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsChecked, ElementName=NavTextRules, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <!-- 彩色渲染规则卡片 -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="文本彩色渲染规则" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="让指定文字变成指定颜色/字重，例如：红队 → 红色 Light 细体；也可勾选“使用正则”并用“高亮第几组”只染捕获组。"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Content="导出规则配置..." Width="110" Padding="6,3" Margin="0,0,8,0" Click="ExportRulesButton_Click"/>
                                        <Button Content="导入规则配置..." Width="110" Padding="6,3" Margin="0,0,8,0" Click="ImportRulesButton_Click"/>
                                        <Button Content="正则教程" Width="80" Padding="6,3" Click="RegexTutorialButton_Click"/>
                                    </StackPanel>
                                    <ListBox x:Name="ColorRuleListBox"
                                             Height="100"
                                             DisplayMemberPath="DisplayText"
                                             SelectionChanged="ColorRuleListBox_SelectionChanged"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="匹配文字" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="ColorRuleTextTextBox" Grid.Column="1" MinWidth="120" Margin="0,0,8,0" Padding="2"/>
                                        <Border x:Name="ColorRuleColorPreview" Grid.Column="2" Width="26" Height="22" BorderBrush="#888888" BorderThickness="1" Background="Red" CornerRadius="3" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <Button Grid.Column="3" Content="颜色..." Width="70" Padding="4,1" Margin="0,0,6,0" Click="ChooseColorRuleColorButton_Click"/>
                                        <ComboBox x:Name="ColorRuleWeightComboBox" Grid.Column="4" Width="90" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="5" Content="添加" Width="60" Padding="4,1" Margin="0,0,6,0" Click="AddColorRuleButton_Click"/>
                                        <Button Grid.Column="6" Content="更新选中" Width="70" Padding="4,1" Click="UpdateColorRuleButton_Click"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <CheckBox x:Name="ColorRuleRegexCheckBox" Content="使用正则" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource ToggleSwitchStyle}"/>
                                        <TextBlock Text="高亮第几组（0=整段，1=第一个括号）" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="ColorRuleRegexGroupTextBox" Width="40" Text="0" Padding="1" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="整句颜色（仅正则+组&gt;0时生效）" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Border x:Name="ColorRuleMatchColorPreview" Width="26" Height="22" BorderBrush="#888888" BorderThickness="1" Background="Transparent" CornerRadius="3" Margin="0,0,6,0"/>
                                        <Button Content="选择整句颜色..." Width="100" Padding="4,1" Margin="0,0,6,0" Click="ChooseColorRuleMatchColorButton_Click"/>
                                        <Button Content="清除" Width="50" Padding="4,1" Click="ClearColorRuleMatchColorButton_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <CheckBox x:Name="ColorRuleEnabledCheckBox"
                                                  Content="启用此规则"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Checked="ColorRuleEnabledCheckBox_Changed"
                                                  Unchecked="ColorRuleEnabledCheckBox_Changed"/>
                                    </StackPanel>
                                    <Button Content="删除选中规则" Width="110" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="6,2" Click="DeleteColorRuleButton_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- 文本替换/屏蔽卡片 -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="文本替换 / 屏蔽" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="文本替换：支持普通文字，也支持正则。例如 玩家 (.+?) 退出了游戏！ 替换为 玩家 $1 离开了。" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <ListBox x:Name="ReplaceRuleListBox"
                                             Height="90"
                                             DisplayMemberPath="DisplayText"
                                             SelectionChanged="ReplaceRuleListBox_SelectionChanged"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="查找" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="ReplaceFindTextBox" Grid.Column="1" MinWidth="100" Margin="0,0,8,0" Padding="2"/>
                                        <TextBlock Grid.Column="2" Text="替换为" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="ReplaceWithTextBox" Grid.Column="3" MinWidth="100" Margin="0,0,8,0" Padding="2"/>
                                        <Button Grid.Column="4" Content="添加" Width="60" Padding="4,1" Margin="0,0,6,0" Click="AddReplaceRuleButton_Click"/>
                                        <Button Grid.Column="5" Content="更新选中" Width="70" Padding="4,1" Margin="0,0,6,0" Click="UpdateReplaceRuleButton_Click"/>
                                        <Button Grid.Column="6" Content="删除" Width="60" Padding="4,1" Click="DeleteReplaceRuleButton_Click"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <CheckBox x:Name="ReplaceRegexCheckBox" Content="使用正则（替换内容可用 $1）" VerticalAlignment="Center" Margin="0,0,16,0" Style="{StaticResource ToggleSwitchStyle}"/>
                                        <CheckBox x:Name="ReplaceOnlyPlayerContentCheckBox" Content="仅替换玩家发言内容（ID > 内容）" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <CheckBox x:Name="ReplaceRuleEnabledCheckBox"
                                                  Content="启用此规则"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Checked="ReplaceRuleEnabledCheckBox_Changed"
                                                  Unchecked="ReplaceRuleEnabledCheckBox_Changed"/>
                                    </StackPanel>

                                    <TextBlock Text="屏蔽关键词：聊天内容包含以下任意词时，不显示到悬浮窗，但后端日志仍会输出。" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4"/>
                                    <ListBox x:Name="BlockKeywordListBox" Height="70" DisplayMemberPath="DisplayText" SelectionChanged="BlockKeywordListBox_SelectionChanged"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="关键词" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="BlockKeywordTextBox" Grid.Column="1" Margin="0,0,8,0" Padding="2"/>
                                        <Button Grid.Column="2" Content="添加" Width="60" Padding="4,1" Margin="0,0,6,0" Click="AddBlockKeywordButton_Click"/>
                                        <Button Grid.Column="3" Content="删除选中" Width="70" Padding="4,1" Click="DeleteBlockKeywordButton_Click"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <CheckBox x:Name="BlockKeywordEnabledCheckBox"
                                                  Content="启用此关键词"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Checked="BlockKeywordEnabledCheckBox_Changed"
                                                  Unchecked="BlockKeywordEnabledCheckBox_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 调试后台面板 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsChecked, ElementName=NavDebug, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="调试后台" Style="{StaticResource SectionTitleStyle}"/>
                                    <CheckBox x:Name="EnableDebugLogCheckBox"
                                              Content="启用后端日志（调试用）"
                                              Margin="0,0,0,8"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="EnableDebugLogCheckBox_Changed"
                                              Unchecked="EnableDebugLogCheckBox_Changed"/>
                                    <Border x:Name="DebugLogGroup"
                                            Visibility="Collapsed"
                                            Background="Transparent">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Button Content="复制日志" Width="90" Padding="6,3" Margin="0,0,8,0" Click="CopyDebugLogButton_Click"/>
                                                <Button Content="清空日志" Width="90" Padding="6,3" Click="ClearDebugLogButton_Click"/>
                                            </StackPanel>
                                            <TextBox x:Name="DebugLogTextBox"
                                                     Height="200"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     FontFamily="Consolas"
                                                     FontSize="12"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="发送到悬浮窗：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox x:Name="ManualMessageTextBox" MinWidth="240" Padding="4,2" VerticalContentAlignment="Center"/>
                                                <Button Content="发送" Width="70" Padding="8,3" Margin="6,0,0,0" Click="SendManualMessageButton_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 底部状态栏 -->
                <Border x:Name="StatusBarBorder"
                        Grid.Row="2"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatusTextBlock"
                                   Text="未开始监听"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>