<Window x:Class="MinecraftChatOverlay.BiliQrLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="扫码登录 B站"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI, PingFang SC, sans-serif"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MinecraftChatOverlay;component/ModernControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="22,20,22,22">
        <TextBlock Text="扫码登录 B站"
                   Style="{StaticResource PanelTitleStyle}"/>
        <TextBlock Text="打开哔哩哔哩 App → 右上角「+」→ 扫一扫"
                   Style="{StaticResource PanelDescStyle}"
                   Margin="0,6,0,0"/>

        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="16">
            <StackPanel>
                <!-- 二维码需要浅底才好扫，这里固定白底 -->
                <Border Background="White"
                        CornerRadius="10"
                        Padding="10"
                        HorizontalAlignment="Center">
                    <Grid Width="230" Height="230">
                        <Image x:Name="QrImage" Stretch="Uniform"/>
                        <TextBlock x:Name="QrPlaceholder"
                                   Text="正在获取二维码…"
                                   Foreground="#888888"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="StatusText"
                           Text=""
                           Margin="0,14,0,0"
                           FontSize="12.5"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button Content="刷新二维码"
                    Click="RefreshButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="110"/>
            <Button Content="取消"
                    Click="CancelButton_Click"
                    Style="{StaticResource SmallButtonStyle}"
                    MinWidth="80"
                    Margin="10,0,0,0"/>
        </StackPanel>

        <TextBlock Text="登录信息只保存在本机配置里，不会上传。"
                   Style="{StaticResource HintStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,12,0,0"/>
    </StackPanel>
</Window>
