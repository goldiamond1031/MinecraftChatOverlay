<Window x:Class="MinecraftChatOverlay.KillBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KillBannerWindow"
        Width="560" Height="170"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False" IsHitTestVisible="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!--
        整块窗口是「铺满全屏的透明画布」，图标按百分比坐标摆在里面。

        **这个窗口是常驻的**（v14 起）：程序启动就创建并 Show 出来，之后**再也不 Hide/Show**。
        平时图标是 Collapsed + 窗口整体穿透，肉眼完全看不见；
        击杀时只是把图标的 Opacity 从 0 动画到 1 再回 0。

        为什么改成常驻：反复 Hide()/Show() 一个铺满全屏的 layered window
        本身就是扰动源 —— 每次显示都要重新参与 z-order 排序、重建 layered surface，
        全屏游戏会被这动作干扰（表现为游戏掉帧/失焦/鼠标跑出来）。
        常驻之后窗口的 Win32 状态从头到尾不变，物理上不可能再扰动游戏。

        背景为什么用 #01000000 而不是 Transparent：
        纯 Transparent 的窗口在部分显卡驱动下鼠标穿透行为不一致，
        给个 alpha=1 的底能稳定拿到 layered window 的穿透语义，肉眼看仍是全透明。

        ⚠ 鼠标穿透的真正保证在 Win32 层的 WS_EX_TRANSPARENT（见 KillBannerWindow.xaml.cs
        的 SetClickThrough），不是这里的 IsHitTestVisible —— 后者只管 WPF 层的命中测试，
        管不到"窗口在系统眼里可不可点"，所以光靠它鼠标光标还是会露出来。
    -->
    <Grid x:Name="RootCanvas" Background="Transparent">

        <!-- 用户导入的击杀图标。软件不再附带内置矢量图，所以这里只有 Image 一种载体。
             平时 Collapsed；击杀时才置为 Visible 并播透明度动画。 -->
        <Viewbox x:Name="IconHost"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Stretch="Uniform"
                 Visibility="Collapsed">
            <Image x:Name="IconImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <!-- 一圈黑色描边阴影：亮背景和暗背景上都能看清 -->
                    <DropShadowEffect x:Name="IconHalo" Color="#000000" BlurRadius="7"
                                      ShadowDepth="0" Opacity="0.9"/>
                </Image.Effect>
            </Image>
        </Viewbox>

    </Grid>
</Window>
