    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="13"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Border x:Name="track"
                                Width="9"
                                HorizontalAlignment="Center"
                                CornerRadius="4"
                                Background="{DynamicResource Surface3Brush}"/>
                        <Track x:Name="PART_Track"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True"
                               Minimum="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}}"
                               Maximum="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}}"
                               ViewportSize="{Binding ViewportSize, RelativeSource={RelativeSource TemplatedParent}}"
                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              Opacity="0"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="9">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="thumb"
                                                    Width="9"
                                                    CornerRadius="4"
                                                    Background="{DynamicResource BorderStrongBrush}"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="thumb" Property="Background" Value="{DynamicResource TextTertiaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="thumb" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              Opacity="0"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         规则列表数据模板
         ========================================================= -->
    <DataTemplate x:Key="ColorRuleItemTemplate">
        <Grid x:Name="RootGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="15" Height="15" CornerRadius="5" VerticalAlignment="Center"
                    Background="{Binding Color, Converter={StaticResource HexToBrushConverter}}"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding Text}"
                       Margin="10,0,8,0"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="regexChip"
                        Style="{StaticResource ChipPrimaryBorderStyle}"
                        Visibility="Collapsed"
                        VerticalAlignment="Center">
                    <TextBlock Text="正则" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                </Border>
                <Border Style="{StaticResource ChipBorderStyle}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FontWeight}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding UseRegex}" Value="True">
                <Setter TargetName="regexChip" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="RootGrid" Property="Opacity" Value="0.5"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="ReplaceRuleItemTemplate">
        <Grid x:Name="RootGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="🔁" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding FindText}" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="→ " FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding ReplaceText}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="regexChip"
                        Style="{StaticResource ChipPrimaryBorderStyle}"
                        Visibility="Collapsed"
                        VerticalAlignment="Center">
                    <TextBlock Text="正则" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                </Border>
                <Border x:Name="playerChip"
                        Style="{StaticResource ChipMintBorderStyle}"
                        Visibility="Collapsed"
                        VerticalAlignment="Center">
                    <TextBlock Text="玩家内容" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource MintBrush}"/>
                </Border>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding UseRegex}" Value="True">
                <Setter TargetName="regexChip" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding OnlyPlayerContent}" Value="True">
                <Setter TargetName="playerChip" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="RootGrid" Property="Opacity" Value="0.5"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="BlockKeywordItemTemplate">
        <Grid x:Name="RootGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="15" Height="15" CornerRadius="5" VerticalAlignment="Center"
                    Background="{DynamicResource DangerSoftBrush}"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding Keyword}"
                       Margin="10,0,0,0"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="RootGrid" Property="Opacity" Value="0.5"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
