<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:MinecraftChatOverlay">

    <!-- =========================================================
         基础颜色（与 GUI.html 原型保持一致）
         ========================================================= -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#EDEDF1"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#F4F4F7"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#EAEAEF"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#FBFBFC"/>
    <SolidColorBrush x:Key="ContentBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E7E7EC"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#D4D4DB"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2A2A31"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E6E7A"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9B9BA7"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#7C6CF0"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#A18CFF"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#5F4AD6"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#1F7C6CF0"/>
    <SolidColorBrush x:Key="PrimarySofterBrush" Color="#127C6CF0"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF8FBE"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#26FF8FBE"/>
    <SolidColorBrush x:Key="MintBrush" Color="#3FCFA9"/>
    <SolidColorBrush x:Key="MintSoftBrush" Color="#263FCFA9"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B81"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#21FF6B81"/>
    <SolidColorBrush x:Key="AmberBrush" Color="#FFB547"/>
    <SolidColorBrush x:Key="SkyBrush" Color="#57C5F2"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#E4E4EA"/>
    <SolidColorBrush x:Key="HoverBgBrush" Color="#F4F4F7"/>
    <SolidColorBrush x:Key="PressedBgBrush" Color="#EAEAEF"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#F5F6FA"/>
    <SolidColorBrush x:Key="SwitchTrackBrush" Color="#E4E4EA"/>
    <SolidColorBrush x:Key="SwitchTrackBorderBrush" Color="#D4D4DB"/>
    <SolidColorBrush x:Key="SwitchThumbBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ConsoleBgBrush" Color="#12101F"/>
    <SolidColorBrush x:Key="ConsoleTextBrush" Color="#CFC9F5"/>
    <SolidColorBrush x:Key="ConsoleMutedBrush" Color="#6F6A9A"/>
    <SolidColorBrush x:Key="ConsoleChatBrush" Color="#9BE7C4"/>
    <SolidColorBrush x:Key="ConsoleInfoBrush" Color="#B4A8FF"/>
    <SolidColorBrush x:Key="ConsoleWarnBrush" Color="#FFC069"/>

    <Color x:Key="PrimaryColor">#7C6CF0</Color>

    <!-- =========================================================
         阴影 / 效果
         ========================================================= -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="3" Opacity="0.07" Color="#1E1E28"/>
    <DropShadowEffect x:Key="CardHoverShadow" BlurRadius="24" ShadowDepth="6" Opacity="0.11" Color="#1E1E28"/>
    <DropShadowEffect x:Key="HoverShadow" BlurRadius="16" ShadowDepth="4" Opacity="0.15" Color="#000000"/>
    <DropShadowEffect x:Key="GlowShadow" BlurRadius="16" ShadowDepth="0" Opacity="0.35" Color="#7C6CF0"/>

    <!-- 玩家查询字段下拉的候选项：中文名 + 路径 + 来源标注（库里的显示"推荐"，从数据里扫出来的显示"实测"） -->
    <DataTemplate x:Key="FieldOptionItemTemplate">
        <StackPanel Orientation="Horizontal" Margin="0,2">
            <Border x:Name="Badge" Padding="5,0" Margin="0,0,9,0" CornerRadius="4" VerticalAlignment="Center"
                    Background="{DynamicResource PrimarySoftBrush}">
                <TextBlock x:Name="BadgeText" Text="推荐" FontSize="10" Foreground="{DynamicResource PrimaryBrush}"/>
            </Border>
            <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" MinWidth="92"
                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Path}" FontSize="11" FontFamily="Consolas, Cascadia Mono, monospace"
                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="10,0,0,0"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Source}" Value="FromData">
                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource MintSoftBrush}"/>
                <Setter TargetName="BadgeText" Property="Text" Value="实测"/>
                <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource MintBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- TextSearch.Text 绑到 Path：选中之后编辑框里显示的就是路径本身 -->
    <Style x:Key="FieldOptionContainerStyle" TargetType="ComboBoxItem">
        <Setter Property="TextSearch.Text" Value="{Binding Path}"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <local:HexToBrushConverter x:Key="HexToBrushConverter"/>

    <!-- =========================================================
         文本样式
         ========================================================= -->
    <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="PanelDescStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="CardDescStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>

    <Style x:Key="HintStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="ChipBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <Style x:Key="ChipPrimaryBorderStyle" TargetType="Border" BasedOn="{StaticResource ChipBorderStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
    </Style>

    <Style x:Key="ChipMintBorderStyle" TargetType="Border" BasedOn="{StaticResource ChipBorderStyle}">
        <Setter Property="Background" Value="{DynamicResource MintSoftBrush}"/>
    </Style>

    <!-- =========================================================
         卡片
         ========================================================= -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect" Value="{DynamicResource CardHoverShadow}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- 含蓄轻快：只浮 2px，200ms 快速起步后极缓收尾 -->
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             To="-2" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <QuinticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- 离开略慢于进入，避免"啪"地弹回去 -->
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             To="0" Duration="0:0:0.24">
                                <DoubleAnimation.EasingFunction>
                                    <QuinticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- =========================================================
         按钮
         ========================================================= -->
    <Style x:Key="BtnStyle" TargetType="Button">
        <Setter Property="Height" Value="40"/>
        <Setter Property="MinWidth" Value="72"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="sink" Y="0"/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="0"
                                SnapsToDevicePixels="True">
                            <Grid ClipToBounds="True">
                                <Border x:Name="shine"
                                        HorizontalAlignment="Stretch"
                                        Opacity="0.95"
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <LinearGradientBrush.RelativeTransform>
                                                <TranslateTransform x:Name="shineBrushTransform" X="-1.4"/>
                                            </LinearGradientBrush.RelativeTransform>
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="#B3FFFFFF" Offset="0.5"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            <Setter TargetName="border" Property="Effect" Value="{DynamicResource CardHoverShadow}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="shineBrushTransform"
                                                         Storyboard.TargetProperty="X"
                                                         From="-1.4" To="1.4"
                                                         Duration="0:0:0.82">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="primary"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="danger"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource DangerBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="ghost"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="Transparent"/>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- 含蓄轻快：按下不是"缩小"而是"轻微下沉"，90ms 跟手 -->
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.985" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.985" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="sink"
                                                         Storyboard.TargetProperty="Y"
                                                         To="1" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- 回弹刻意比按下慢（260ms vs 90ms），手感才柔 -->
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="sink"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource BtnStyle}"/>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BtnStyle}">
        <Setter Property="Tag" Value="primary"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BtnStyle}">
        <Setter Property="Tag" Value="danger"/>
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource BtnStyle}">
        <Setter Property="Tag" Value="ghost"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource BtnStyle}">
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <Style x:Key="SmallPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
        <Setter Property="Tag" Value="primary"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
    </Style>

    <Style x:Key="SmallDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
        <Setter Property="Tag" Value="danger"/>
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="SmallGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
        <Setter Property="Tag" Value="ghost"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <Style x:Key="WindowControlButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Surface3Brush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="close">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="close"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource DangerBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource DangerBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         开关 / 卡片式复选
         ========================================================= -->
    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="card"
                            Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="14"
                            Padding="13,12"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="44" Height="25" VerticalAlignment="Top" Margin="0,1,0,0">
                                <Border x:Name="track"
                                        Background="{DynamicResource TrackBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12.5"/>
                                <!-- 轨道填充层：用透明度做柔和变色，并故意比滑块晚 40ms 跟上 —— "被带动"的跟随感。
                                     用独立图层而不是直接在 track 上做 ColorAnimation，是因为 track 的 Background
                                     是 DynamicResource 共享画刷，动画它会污染所有开关。 -->
                                <Border x:Name="trackFill"
                                        Background="{DynamicResource PrimaryBrush}"
                                        Margin="1"
                                        CornerRadius="11.5"
                                        Opacity="0"/>
                                <Ellipse x:Name="thumb"
                                         Width="19" Height="19"
                                         Fill="{DynamicResource SwitchThumbBrush}"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <!-- 用位移代替 Margin 动画：动画 Margin 会每帧触发布局重算 -->
                                        <TranslateTransform x:Name="thumbShift" X="0"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="5" ShadowDepth="0" Opacity="0.28" Color="#000000"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- 滑块 260ms 带轻微过冲弹到位（BackEase 0.4 ≈ 15% 过冲）—— 这一下就是"雀跃" -->
                                        <DoubleAnimation Storyboard.TargetName="thumbShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="19" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.4" EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <!-- 轨道填充晚 40ms 跟上：滑块先到、颜色后到，产生"被带动"的跟随感 -->
                                        <DoubleAnimation Storyboard.TargetName="trackFill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.22" BeginTime="0:0:0.04">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="thumbShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.4" EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="trackFill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.2" BeginTime="0:0:0.04">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="card" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            <Setter TargetName="card" Property="Effect" Value="{DynamicResource CardHoverShadow}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="card"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="-2" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="card"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="card" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InlineToggleStyle" TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitchStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="34" Height="20" VerticalAlignment="Center">
                            <Border x:Name="track"
                                    Background="{DynamicResource TrackBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"/>
                            <Border x:Name="trackFill"
                                    Background="{DynamicResource PrimaryBrush}"
                                    Margin="1"
                                    CornerRadius="9"
                                    Opacity="0"/>
                            <Ellipse x:Name="thumb"
                                     Width="14" Height="14"
                                     Fill="{DynamicResource SwitchThumbBrush}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="thumbShift" X="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.24" Color="#000000"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="thumbShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="14" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.4" EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="trackFill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.22" BeginTime="0:0:0.04">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="thumbShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.4" EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="trackFill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.2" BeginTime="0:0:0.04">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="Effect" Value="{DynamicResource HoverShadow}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

