        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         侧边栏导航
         ========================================================= -->
    <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="border"
                            Background="Transparent"
                            CornerRadius="10"
                            Padding="13,12"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform X="0"/>
                        </Border.RenderTransform>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="border"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="4" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="border"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimarySofterBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         列表
         ========================================================= -->
    <!--
        列表。
        **必须自己写 ControlTemplate** —— 只设 Background="Transparent" 是不够的：
        WPF 默认的 ListBox 模板（Aero2）里有一个叫 Bd 的 Border 负责背涂，
        它取的是 SystemColors.WindowBrush，**跟应用的 Background 属性和主题都无关**。
        系统是浅色时那块就是纯白，压在暗色卡片上就是一块"日间白"。
        这是"暗色模式下列表背景发白"的真正根因 —— 和 IsEnabled / 文字颜色都没关系，
        开关开着也是白的，只是关掉之后没了内容衬托，才显得特别扎眼。

        模板写成"一个纯 ScrollViewer"，不画任何背景，让卡片底色透上来。
    -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False"
                                  Background="Transparent"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        普通复选方框（不带 x:Key，作为默认样式）。
        列表里的"勾上 = 参与随机抽取"用的就是它。

        **必须自己写模板**：WPF 默认的 CheckBox 模板（Aero2）里那个方框是画死的
        白色底 + 系统色描边，跟应用主题完全无关。暗色卡片上就是一堆刺眼的白方块。

        写成"圆角方框 + 对勾"的最小实现：
          - 底色 Surface2Brush，跟卡片有层次但同色系
          - 勾选后填 PrimaryBrush，对勾用白色
          - 悬停时描边提亮
    -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <!--
                            禁用态用外层 Opacity 压暗，**不要**单独去改 box / check 的透明度 ——
                            那样会和"勾选/未勾选"这两个触发器打架（谁写在后面谁赢），
                            结果就是未勾选时也显示一个淡淡的对勾。
                            压在外层就没有优先级问题：勾选态该有的对勾照样有，只是整体变暗。
                        -->
                        <Border x:Name="boxHost" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="boxScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border x:Name="box"
                                    Width="17" Height="17"
                                    CornerRadius="5"
                                    Background="{DynamicResource Surface2Brush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}"
                                    BorderThickness="1.5"
                                    VerticalAlignment="Center">
                                <!-- 对勾：用 Path 画，比贴字符清晰且不依赖字体 -->
                                <Path x:Name="check"
                                      Data="M 3.2,8.4 L 6.6,11.6 L 13.2,4.6"
                                      Stroke="{DynamicResource TextOnPrimaryBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Opacity="0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ContentPresenter Margin="9,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="check" Property="Opacity" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- 轻微弹一下，和开关滑块的"雀跃"是一个调子 -->
                                        <DoubleAnimation Storyboard.TargetName="boxScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.14" Duration="0:0:0.1" AutoReverse="True"/>
                                        <DoubleAnimation Storyboard.TargetName="boxScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.14" Duration="0:0:0.1" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                            <Setter TargetName="boxHost" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="itemBorder"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="10,9"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform X="0"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="itemBorder"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="4" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="itemBorder"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource PrimarySofterBrush}"/>
                            <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="itemBorder" Property="Effect" Value="{DynamicResource GlowShadow}"/>
                        </Trigger>
                        <!--
                            禁用态自己接管前景色。
                            不写这条的话，WPF 会套用系统默认的"禁用文字色"（一个跟主题无关的浅灰），
                            在暗色卡片上读不清。
                            注意：这不是"列表背景发白"的原因 —— 那个另有其人，见上面 ListBox 样式里
                            关于 Aero2 模板 Border#Bd 的注释。两件事，别混。
                        -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         滑块
         ========================================================= -->
    <Style TargetType="Slider">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="8" VerticalAlignment="Center" CornerRadius="4" Background="{DynamicResource TrackBrush}"/>
                        <Track x:Name="PART_Track"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="8" VerticalAlignment="Center" CornerRadius="4" Background="{DynamicResource PrimaryBrush}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="18" Height="18" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse x:Name="glow" Fill="Transparent" Margin="-6"/>
                                                <Ellipse Fill="White" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="3"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="glow" Property="Fill" Value="{DynamicResource PrimarySoftBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="8" Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         滚动条（夜间模式不再使用系统日间颜色）
         ========================================================= -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="13"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Border x:Name="track"
                                Width="9"
                                HorizontalAlignment="Center"
                                CornerRadius="4"
                                Background="{DynamicResource Surface3Brush}"/>
                        <Track x:Name="PART_Track"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True"
                               Minimum="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}}"
                               Maximum="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}}"
                               ViewportSize="{Binding ViewportSize, RelativeSource={RelativeSource TemplatedParent}}"
                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              Opacity="0"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="9">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="thumb"
                                                    Width="9"
                                                    CornerRadius="4"
                                                    Background="{DynamicResource BorderStrongBrush}"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="thumb" Property="Background" Value="{DynamicResource TextTertiaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="thumb" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              Opacity="0"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         规则列表数据模板
         ========================================================= -->
    <DataTemplate x:Key="ColorRuleItemTemplate">
        <Grid x:Name="RootGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="15" Height="15" CornerRadius="5" VerticalAlignment="Center"
                    Background="{Binding Color, Converter={StaticResource HexToBrushConverter}}"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding Text}"
                       Margin="10,0,8,0"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="regexChip"
                        Style="{StaticResource ChipPrimaryBorderStyle}"
                        Visibility="Collapsed"
                        VerticalAlignment="Center">
                    <TextBlock Text="正则" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                </Border>
                <Border Style="{StaticResource ChipBorderStyle}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FontWeight}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding UseRegex}" Value="True">
                <Setter TargetName="regexChip" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="RootGrid" Property="Opacity" Value="0.5"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="KillFeedbackEffectItemTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Name}"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Summary}"
                           FontSize="11.5"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <Border x:Name="recChip"
                    Grid.Column="1"
                    Style="{StaticResource ChipPrimaryBorderStyle}"
                    VerticalAlignment="Top"
                    Margin="8,0,0,0"
                    Visibility="Collapsed">
                <TextBlock Text="推荐" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                <Setter TargetName="recChip" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--
        提示音列表项：勾选框 + 文件名。
        勾选框绑 IsPicked（参与随机抽取）。

        勾选框的显隐由 ShowCheckBox 驱动 —— 关掉「随机播放」时它是 Collapsed，
        内容直接靠左，不留下一个空荡荡的格子。ShowCheckBox 由卡片那边跟着随机开关同步。

        这里**不能**写 Checked/Unchecked 事件处理器：这个文件是纯 ResourceDictionary
        （没有 x:Class），XAML 编译器不允许在里面挂事件。所以走另一条路 ——
        卡片那边监听数据项自己的 PropertyChanged（SoundChoice 实现了 INotifyPropertyChanged），
        见 MainWindow.SoundNotify.xaml.cs 的 HookSoundChoiceNotifications。
    -->
    <DataTemplate x:Key="SoundChoiceItemTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0"
                      IsChecked="{Binding IsPicked, Mode=TwoWay}"
                      Visibility="{Binding ShowCheckBox, Converter={StaticResource BoolToVisibility}}"
                      VerticalAlignment="Center"
                      ToolTip="勾上 = 参与随机抽取"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding Name}"
                       Margin="10,0,0,0"
                       FontSize="13"
                       FontWeight="Bold"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ReplaceRuleItemTemplate">
        <Grid x:Name="RootGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="🔁" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding FindText}" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="→ " FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding ReplaceText}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="regexChip"
                        Style="{StaticResource ChipPrimaryBorderStyle}"
                        Visibility="Collapsed"
                        VerticalAlignment="Center">
                    <TextBlock Text="正则" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                </Border>
                <Border x:Name="playerChip"
                        Style="{StaticResource ChipMintBorderStyle}"
                        Visibility="Collapsed"
                        VerticalAlignment="Center">
                    <TextBlock Text="玩家内容" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource MintBrush}"/>
                </Border>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding UseRegex}" Value="True">
                <Setter TargetName="regexChip" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding OnlyPlayerContent}" Value="True">
                <Setter TargetName="playerChip" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="RootGrid" Property="Opacity" Value="0.5"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="BlockKeywordItemTemplate">
        <Grid x:Name="RootGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="15" Height="15" CornerRadius="5" VerticalAlignment="Center"
                    Background="{DynamicResource DangerSoftBrush}"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding Keyword}"
                       Margin="10,0,0,0"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="RootGrid" Property="Opacity" Value="0.5"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
