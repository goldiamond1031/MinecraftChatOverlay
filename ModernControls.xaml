<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:MinecraftChatOverlay">

    <!-- =========================================================
         基础颜色（与 GUI.html 原型保持一致）
         ========================================================= -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#EDEDF1"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#F4F4F7"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#EAEAEF"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#FBFBFC"/>
    <SolidColorBrush x:Key="ContentBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E7E7EC"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#D4D4DB"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2A2A31"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E6E7A"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9B9BA7"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#7C6CF0"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#A18CFF"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#5F4AD6"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#1F7C6CF0"/>
    <SolidColorBrush x:Key="PrimarySofterBrush" Color="#127C6CF0"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF8FBE"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#26FF8FBE"/>
    <SolidColorBrush x:Key="MintBrush" Color="#3FCFA9"/>
    <SolidColorBrush x:Key="MintSoftBrush" Color="#263FCFA9"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B81"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#21FF6B81"/>
    <SolidColorBrush x:Key="AmberBrush" Color="#FFB547"/>
    <SolidColorBrush x:Key="SkyBrush" Color="#57C5F2"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#E4E4EA"/>
    <SolidColorBrush x:Key="HoverBgBrush" Color="#F4F4F7"/>
    <SolidColorBrush x:Key="PressedBgBrush" Color="#EAEAEF"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#F5F6FA"/>
    <SolidColorBrush x:Key="SwitchTrackBrush" Color="#E4E4EA"/>
    <SolidColorBrush x:Key="SwitchTrackBorderBrush" Color="#D4D4DB"/>
    <SolidColorBrush x:Key="SwitchThumbBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ConsoleBgBrush" Color="#12101F"/>
    <SolidColorBrush x:Key="ConsoleTextBrush" Color="#CFC9F5"/>
    <SolidColorBrush x:Key="ConsoleMutedBrush" Color="#6F6A9A"/>
    <SolidColorBrush x:Key="ConsoleChatBrush" Color="#9BE7C4"/>
    <SolidColorBrush x:Key="ConsoleInfoBrush" Color="#B4A8FF"/>
    <SolidColorBrush x:Key="ConsoleWarnBrush" Color="#FFC069"/>

    <Color x:Key="PrimaryColor">#7C6CF0</Color>

    <!-- bool → Visibility。列表项勾选框显隐用（关掉随机时收起来，不留空位） -->
    <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

    <!-- =========================================================
         阴影 / 效果
         ========================================================= -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="3" Opacity="0.07" Color="#1E1E28"/>
    <DropShadowEffect x:Key="CardHoverShadow" BlurRadius="24" ShadowDepth="6" Opacity="0.11" Color="#1E1E28"/>
    <DropShadowEffect x:Key="HoverShadow" BlurRadius="16" ShadowDepth="4" Opacity="0.15" Color="#000000"/>
    <DropShadowEffect x:Key="GlowShadow" BlurRadius="16" ShadowDepth="0" Opacity="0.35" Color="#7C6CF0"/>

    <!-- 玩家查询字段下拉的候选项：中文名 + 路径 + 来源标注（库里的显示"推荐"，从数据里扫出来的显示"实测"） -->
    <DataTemplate x:Key="FieldOptionItemTemplate">
        <StackPanel Orientation="Horizontal" Margin="0,2">
            <Border x:Name="Badge" Padding="5,0" Margin="0,0,9,0" CornerRadius="4" VerticalAlignment="Center"
                    Background="{DynamicResource PrimarySoftBrush}">
                <TextBlock x:Name="BadgeText" Text="推荐" FontSize="10" Foreground="{DynamicResource PrimaryBrush}"/>
            </Border>
            <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" MinWidth="92"
                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Path}" FontSize="11" FontFamily="Consolas, Cascadia Mono, monospace"
                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="10,0,0,0"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Source}" Value="FromData">
                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource MintSoftBrush}"/>
                <Setter TargetName="BadgeText" Property="Text" Value="实测"/>
                <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource MintBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- TextSearch.Text 绑到 Path：选中之后编辑框里显示的就是路径本身 -->
    <Style x:Key="FieldOptionContainerStyle" TargetType="ComboBoxItem">
        <Setter Property="TextSearch.Text" Value="{Binding Path}"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <local:HexToBrushConverter x:Key="HexToBrushConverter"/>

    <!-- =========================================================
         文本样式
         ========================================================= -->
    <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="PanelDescStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="CardDescStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>

    <Style x:Key="HintStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="ChipBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <Style x:Key="ChipPrimaryBorderStyle" TargetType="Border" BasedOn="{StaticResource ChipBorderStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
    </Style>

    <Style x:Key="ChipMintBorderStyle" TargetType="Border" BasedOn="{StaticResource ChipBorderStyle}">
        <Setter Property="Background" Value="{DynamicResource MintSoftBrush}"/>
    </Style>

    <!-- =========================================================
         卡片
         ========================================================= -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect" Value="{DynamicResource CardHoverShadow}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- 含蓄轻快：只浮 2px，200ms 快速起步后极缓收尾 -->
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             To="-2" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <QuinticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- 离开略慢于进入，避免"啪"地弹回去 -->
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             To="0" Duration="0:0:0.24">
                                <DoubleAnimation.EasingFunction>
                                    <QuinticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        插件卡片（「插件」板块里两列网格那颗）：
        悬停语言和 CardStyle 完全一致（阴影加深 + 描边变亮 + 上浮 2px、快进缓出），
        只是更紧凑 —— 圆角、内边距、外边距都比大卡片小一号，好并排摆两列。
    -->
    <Style x:Key="PluginCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,14,16,14"/>
        <Setter Property="Margin" Value="0,0,14,14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect" Value="{DynamicResource CardHoverShadow}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- 和大卡片同一套节奏：只浮 2px，200ms 快速起步后极缓收尾 -->
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             To="-2" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <QuinticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- 离开略慢于进入，避免"啪"地弹回去 -->
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             To="0" Duration="0:0:0.24">
                                <DoubleAnimation.EasingFunction>
                                    <QuinticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        锁定卡片：总开关关掉时，整张卡降饱和 + 压暗，明确告诉用户"现在不生效"。
        跟"局部变灰"不一样 —— 这是卡级的整体状态提示，所以做成独立样式，
        由外面把对应总开关的锁定态绑到 Border.Tag 上（true = 锁定）。

        实现要点：
        - Tag 是个 object 类型的中性槽位，用它传布尔最省事：三个卡片共用同一条
          样式，各自绑自己的键，不用为三个绑定键复制三份样式。
        - 不用 IsEnabled=False 去禁用整卡：总开关本身就在卡片里，
          禁用整卡会连开关一起点不动，用户就永远打不开了。
        - 去掉 Effect 是因为 Opacity 之后阴影会显得脏，索性一起收掉。
    -->
    <Style x:Key="LockedCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Style.Triggers>
            <Trigger Property="Tag" Value="True">
                <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Opacity" Value="0.62"/>
                <Setter Property="Effect" Value="{x:Null}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- =========================================================
         按钮
         ========================================================= -->
    <Style x:Key="BtnStyle" TargetType="Button">
        <Setter Property="Height" Value="40"/>
        <Setter Property="MinWidth" Value="72"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="sink" Y="0"/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="0"
                                SnapsToDevicePixels="True">
                            <Grid ClipToBounds="True">
                                <Border x:Name="shine"
                                        HorizontalAlignment="Stretch"
                                        Opacity="0.95"
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <LinearGradientBrush.RelativeTransform>
                                                <TranslateTransform x:Name="shineBrushTransform" X="-1.4"/>
                                            </LinearGradientBrush.RelativeTransform>
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="#B3FFFFFF" Offset="0.5"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            <Setter TargetName="border" Property="Effect" Value="{DynamicResource CardHoverShadow}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="shineBrushTransform"
                                                         Storyboard.TargetProperty="X"
                                                         From="-1.4" To="1.4"
                                                         Duration="0:0:0.82">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="primary"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="danger"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource DangerBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="ghost"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="Transparent"/>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- 含蓄轻快：按下不是"缩小"而是"轻微下沉"，90ms 跟手 -->
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.985" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.985" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="sink"
                                                         Storyboard.TargetProperty="Y"
                                                         To="1" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- 回弹刻意比按下慢（260ms vs 90ms），手感才柔 -->
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="sink"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource BtnStyle}"/>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BtnStyle}">
        <Setter Property="Tag" Value="primary"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BtnStyle}">
        <Setter Property="Tag" Value="danger"/>
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource BtnStyle}">
        <Setter Property="Tag" Value="ghost"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource BtnStyle}">
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <Style x:Key="SmallPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
        <Setter Property="Tag" Value="primary"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
    </Style>

    <Style x:Key="SmallDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
        <Setter Property="Tag" Value="danger"/>
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="SmallGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
        <Setter Property="Tag" Value="ghost"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!--
      「拖动定位」用的开关式按钮。
      不能用 SmallPrimaryButtonStyle —— 那个 TargetType 是 Button，
      套到 ToggleButton 上会被 WPF 静默忽略（找不到匹配的样式就直接用默认外观），
      结果是按钮长得完全不像预期。这里照着小尺寸重写一份。
    -->
    <Style x:Key="SmallPrimaryToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- 选中 = 拖动模式开着，换个底色让人一眼看出"现在正在拖" -->
                            <Setter TargetName="root" Property="Background" Value="{DynamicResource DangerBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      「击杀反馈」效果列表里的小控件。
      不能基于 BtnStyle —— 它带 MinWidth=72 / Height=40 / Padding=16,0，
      会给色块按钮撑出一个大胶囊，压在右边的数字框上。这里全部重写成小尺寸。
    -->
    <Style x:Key="SwatchButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      效果列表里的百分比输入框。
      隐式 TextBox 样式是 MinHeight=40 + Padding=12,0 的圆角框，放在这种一行一效果
      的紧凑列表里会又高又挤。这里收成 30 高、右边距小一点，数字居中偏右。
