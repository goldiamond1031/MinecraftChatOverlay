<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>FpsOverlayPlugin</AssemblyName>
    <RootNamespace>MinecraftChatOverlay.Plugins.FpsOverlay</RootNamespace>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <!-- 链进来的主工程源码带自己的 nullable 习惯，别在这里报一堆警告 -->
    <NoWarn>$(NoWarn);CS8618;CS8600;CS8602;CS8604;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\MinecraftChatOverlay.Plugin.Abstractions.csproj" />
  </ItemGroup>

  <!--
    复用主程序那套已经实测跑通的手动映射注入器（tools\GmBlurCli 也是用
    Compile Include 链主工程源码的，这里照同一个套路）。
    这三个文件只依赖 BCL，不碰主工程任何其他类型，链进来就能用。
  -->
  <ItemGroup>
    <Compile Include="..\..\Services\GameMotionBlur\GameProcessInjector.cs" Link="Injection\GameProcessInjector.cs" />
    <Compile Include="..\..\Services\GameMotionBlur\ManualMapper.cs" Link="Injection\ManualMapper.cs" />
    <Compile Include="..\..\Services\GameMotionBlur\ManualMapper.Remote.cs" Link="Injection\ManualMapper.Remote.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    只数帧的原生探针。编译时从 native\dist 带过来，跟 GameMotionBlurHook 一个套路。
    没编过 native 也不影响插件编译（只是运行时会提示找不到 DLL）。
  -->
  <ItemGroup>
    <None Include="..\..\native\dist\FpsProbeHook.dll" Link="FpsProbeHook.dll"
          Condition="Exists('..\..\native\dist\FpsProbeHook.dll')"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
