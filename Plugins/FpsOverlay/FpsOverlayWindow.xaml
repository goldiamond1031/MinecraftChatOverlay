<Window x:Class="MinecraftChatOverlay.Plugins.FpsOverlay.FpsOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FPS 悬浮窗"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border x:Name="RootBorder"
            CornerRadius="6"
            Background="#59000000"
            Padding="10,4">
        <TextBlock x:Name="FpsText"
                   Text="FPS --"
                   FontFamily="Consolas"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#FFFFFF" />
    </Border>

</Window>
