<UserControl x:Class="MinecraftChatOverlay.Plugins.FpsOverlay.FpsOverlayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        样式和画刷一律 DynamicResource：插件控件是"先 new 出来、再挂进宿主窗口"的，
        StaticResource 在解析那一刻找不到宿主 Window 里的资源字典，会直接抛 XamlParseException（DEV-NOTES 坑 52）。
        页面里自己定义的那几个（本 UserControl.Resources）才可以用 StaticResource。
    -->
    <UserControl.Resources>
        <!-- 色块按钮：不 BasedOn 隐式 Button 样式，免得被隐式的 MinWidth=72 / MinHeight 顶开（坑 18） -->
        <Style x:Key="ColorSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#66808080"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="RowTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,20">

            <!-- ===================== 1. 目标游戏 ===================== -->
            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="1. 选目标游戏" Style="{DynamicResource CardTitleStyle}"/>
                    <TextBlock Style="{DynamicResource CardDescStyle}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="选一个正在跑的游戏窗口，点【注入并开始】。探针只记 SwapBuffers 被调了多少次 —— 不读像素、不改画面、不加任何渲染效果；显示层是这个插件自己的独立悬浮窗，不碰游戏。"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="TargetComboBox" Height="34" Loaded="ComboBox_Loaded"
                                  ToolTip="Java 版游戏一般是 javaw.exe"/>
                        <Button Grid.Column="1" x:Name="RefreshButton" Content="刷新列表" Margin="8,0,0,0"
                                Style="{DynamicResource SmallButtonStyle}" Click="RefreshButton_Click"/>
                        <Button Grid.Column="2" x:Name="StartButton" Content="注入并开始" Margin="8,0,0,0"
                                Style="{DynamicResource SmallPrimaryButtonStyle}" Click="StartButton_Click"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="StopButton" Content="停止并隐藏" Margin="0"
                                Style="{DynamicResource SmallGhostButtonStyle}" Click="StopButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusText" Style="{DynamicResource HintStyle}" TextWrapping="Wrap"
                               Margin="0,12,0,0" Text="还没开始。"/>
                </StackPanel>
            </Border>

            <!-- ===================== 2. 显示内容 ===================== -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="2. 显示内容" Style="{DynamicResource CardTitleStyle}"/>
                    <TextBlock Style="{DynamicResource CardDescStyle}" TextWrapping="Wrap" Margin="0,4,0,14"
                               Text="最后显示的就是「前缀 + 数字 + 后缀」。"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="前缀" Style="{StaticResource RowLabelStyle}"/>
                        <TextBox Grid.Column="1" x:Name="PrefixBox" Style="{StaticResource RowTextBoxStyle}"
                                 TextChanged="Text_Changed" ToolTip="例如 FPS "/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="后缀" Style="{StaticResource RowLabelStyle}"/>
                        <TextBox Grid.Column="1" x:Name="SuffixBox" Style="{StaticResource RowTextBoxStyle}"
                                 TextChanged="Text_Changed" ToolTip="例如 帧，留空也行"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="小数位" Style="{StaticResource RowLabelStyle}"/>
                        <ComboBox Grid.Column="1" x:Name="DecimalsCombo" Height="32"
                                  SelectionChanged="Select_Changed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===================== 3. 文字 ===================== -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="3. 文字" Style="{DynamicResource CardTitleStyle}"/>
                    <TextBlock Style="{DynamicResource CardDescStyle}" TextWrapping="Wrap" Margin="0,4,0,14"
                               Text="字体下拉里是你系统里装的所有字体。"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="字体" Style="{StaticResource RowLabelStyle}"/>
                        <ComboBox Grid.Column="1" x:Name="FontCombo" Height="32"
                                  SelectionChanged="Select_Changed"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="字号" Style="{StaticResource RowLabelStyle}"/>
                        <TextBox Grid.Column="1" x:Name="FontSizeBox" Style="{StaticResource RowTextBoxStyle}"
                                 TextChanged="Text_Changed"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="字重" Style="{StaticResource RowLabelStyle}"/>
                        <ComboBox Grid.Column="1" x:Name="WeightCombo" Height="32"
                                  SelectionChanged="Select_Changed"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="文字颜色" Style="{StaticResource RowLabelStyle}"/>
                        <TextBox Grid.Column="1" x:Name="ForegroundBox" Style="{StaticResource RowTextBoxStyle}"
                                 TextChanged="Text_Changed" ToolTip="#RRGGBB"/>
                    </Grid>
                    <StackPanel x:Name="ForegroundSwatches" Orientation="Horizontal" Margin="92,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- ===================== 4. 文字阴影 ===================== -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="4. 文字阴影" Style="{DynamicResource CardTitleStyle}"/>
                    <TextBlock Style="{DynamicResource CardDescStyle}" TextWrapping="Wrap" Margin="0,4,0,14"
                               Text="给数字描一层投影，在亮背景的游戏画面上更清楚。"/>

                    <CheckBox x:Name="ShadowCheckBox" Style="{DynamicResource ToggleSwitchStyle}"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed">
                        <TextBlock Text="启用文字阴影" FontSize="13" FontWeight="Bold"/>
                    </CheckBox>

                    <StackPanel x:Name="ShadowPanel" Margin="0,14,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="阴影颜色" Style="{StaticResource RowLabelStyle}"/>
                            <TextBox Grid.Column="1" x:Name="ShadowColorBox" Style="{StaticResource RowTextBoxStyle}"
                                     TextChanged="Text_Changed" ToolTip="#RRGGBB"/>
                        </Grid>
                        <StackPanel x:Name="ShadowSwatches" Orientation="Horizontal" Margin="92,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模糊半径" Style="{StaticResource RowLabelStyle}"/>
                            <TextBox Grid.Column="1" x:Name="ShadowBlurBox" Style="{StaticResource RowTextBoxStyle}"
                                     TextChanged="Text_Changed"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="偏移 X" Style="{StaticResource RowLabelStyle}"/>
                            <TextBox Grid.Column="1" x:Name="ShadowOffsetXBox" Style="{StaticResource RowTextBoxStyle}"
                                     Margin="0,0,12,0" TextChanged="Text_Changed"/>
                            <TextBlock Grid.Column="2" Text="偏移 Y" Style="{StaticResource RowLabelStyle}"/>
                            <TextBox Grid.Column="3" x:Name="ShadowOffsetYBox" Style="{StaticResource RowTextBoxStyle}"
                                     TextChanged="Text_Changed"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="阴影浓度" Style="{StaticResource RowLabelStyle}"/>
                            <TextBox Grid.Column="1" x:Name="ShadowOpacityBox" Style="{StaticResource RowTextBoxStyle}"
                                     TextChanged="Text_Changed" ToolTip="0 ~ 1"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================== 5. 背景 ===================== -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="5. 背景" Style="{DynamicResource CardTitleStyle}"/>
                    <TextBlock Style="{DynamicResource CardDescStyle}" TextWrapping="Wrap" Margin="0,4,0,14"
                               Text="数字后面那块底。透明度 0 就等于没有底。"/>

                    <CheckBox x:Name="BackgroundCheckBox" Style="{DynamicResource ToggleSwitchStyle}"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed">
                        <TextBlock Text="显示背景" FontSize="13" FontWeight="Bold"/>
                    </CheckBox>

                    <StackPanel x:Name="BackgroundPanel" Margin="0,14,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="背景颜色" Style="{StaticResource RowLabelStyle}"/>
                            <TextBox Grid.Column="1" x:Name="BackgroundColorBox" Style="{StaticResource RowTextBoxStyle}"
                                     TextChanged="Text_Changed" ToolTip="#RRGGBB"/>
                        </Grid>
                        <StackPanel x:Name="BackgroundSwatches" Orientation="Horizontal" Margin="92,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="不透明度" Style="{StaticResource RowLabelStyle}"/>
                            <TextBox Grid.Column="1" x:Name="BackgroundOpacityBox" Style="{StaticResource RowTextBoxStyle}"
                                     Margin="0,0,12,0" TextChanged="Text_Changed" ToolTip="0 ~ 1"/>
                            <TextBlock Grid.Column="2" Text="圆角" Style="{StaticResource RowLabelStyle}"/>
                            <TextBox Grid.Column="3" x:Name="CornerRadiusBox" Style="{StaticResource RowTextBoxStyle}"
                                     TextChanged="Text_Changed"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="左右留白" Style="{StaticResource RowLabelStyle}"/>
                            <TextBox Grid.Column="1" x:Name="PaddingXBox" Style="{StaticResource RowTextBoxStyle}"
                                     Margin="0,0,12,0" TextChanged="Text_Changed"/>
                            <TextBlock Grid.Column="2" Text="上下留白" Style="{StaticResource RowLabelStyle}"/>
                            <TextBox Grid.Column="3" x:Name="PaddingYBox" Style="{StaticResource RowTextBoxStyle}"
                                     TextChanged="Text_Changed"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================== 6. 位置与行为 ===================== -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="6. 位置与行为" Style="{DynamicResource CardTitleStyle}"/>
                    <TextBlock Style="{DynamicResource CardDescStyle}" TextWrapping="Wrap" Margin="0,4,0,14"
                               Text="位置是屏幕坐标（左上角为原点）。关掉鼠标穿透之后，可以直接用鼠标拖悬浮窗，位置会自动记住。"/>

                    <CheckBox x:Name="ClickThroughCheckBox" Style="{DynamicResource ToggleSwitchStyle}"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed">
                        <StackPanel>
                            <TextBlock Text="鼠标穿透" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="开着的时候悬浮窗不吃鼠标（打游戏不会点到它）；关掉才能拖动它"
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox x:Name="VisibleCheckBox" Style="{DynamicResource ToggleSwitchStyle}" Margin="0,16,0,0"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed">
                        <StackPanel>
                            <TextBlock Text="显示悬浮窗" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="关掉只是不显示，探针还在跑，随时可以再打开"
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="位置 X" Style="{StaticResource RowLabelStyle}"/>
                        <TextBox Grid.Column="1" x:Name="LeftBox" Style="{StaticResource RowTextBoxStyle}"
                                 Margin="0,0,12,0" TextChanged="Text_Changed"/>
                        <TextBlock Grid.Column="2" Text="位置 Y" Style="{StaticResource RowLabelStyle}"/>
                        <TextBox Grid.Column="3" x:Name="TopBox" Style="{StaticResource RowTextBoxStyle}"
                                 TextChanged="Text_Changed"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="挪回右上角" Style="{DynamicResource SmallButtonStyle}"
                                Click="ResetPosition_Click"/>
                        <Button Content="恢复全部默认外观" Margin="8,0,0,0"
                                Style="{DynamicResource SmallGhostButtonStyle}" Click="ResetAppearance_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================== 状态 ===================== -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="探针状态" Style="{DynamicResource CardTitleStyle}"/>
                    <TextBlock x:Name="ProbeStatusText" Style="{DynamicResource HintStyle}" TextWrapping="Wrap"
                               Margin="0,8,0,0" Text="还没注入。"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
