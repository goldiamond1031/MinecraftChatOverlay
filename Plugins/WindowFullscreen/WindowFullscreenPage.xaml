<UserControl x:Class="MinecraftChatOverlay.Plugins.WindowFullscreen.WindowFullscreenPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        这一页原来是主程序 MainWindow.Modern.xaml 里的 WindowFullscreenPanel，整块搬过来了。
        页面标题和说明由宿主统一画（插件页头），所以这里没有页头那一块。
    -->
    <StackPanel>
                                <Border Style="{DynamicResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="1. 选择游戏窗口" Style="{DynamicResource CardTitleStyle}"/>
                                        <TextBlock Text="游戏用独占全屏（或者自己按 F11 全屏）时，画面不走桌面合成，悬浮窗再怎么置顶也盖不上去。这里把游戏窗口的标题栏和边框摘掉、铺满屏幕、再压回普通层，它就和窗口化时一样了，悬浮窗恢复正常显示。只改窗口样式和位置，不注入进程、不碰游戏画面，随时可以还原。" Style="{DynamicResource CardDescStyle}" Margin="0,3,0,14"/>                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="WindowFullscreenTargetComboBox"
                                                      Height="34"
                                                      Loaded="ComboBox_Loaded"
                                                      ToolTip="选择游戏窗口，Java 版游戏一般是 javaw.exe"/>
                                            <Button Grid.Column="1"
                                                    Content="刷新列表"
                                                    Click="WindowFullscreenRefreshButton_Click"
                                                    Style="{DynamicResource SmallButtonStyle}"
                                                    Margin="8,0,0,0"/>
                                            <Button Grid.Column="2"
                                                    x:Name="WindowFullscreenApplyButton"
                                                    Content="变无边框全屏"
                                                    Click="WindowFullscreenApplyButton_Click"
                                                    Style="{DynamicResource SmallPrimaryButtonStyle}"
                                                    Margin="8,0,0,0"/>
                                        </Grid>
                                        <TextBlock x:Name="WindowFullscreenStatusText"
                                                   Style="{DynamicResource HintStyle}"
                                                   Text="尚未修改"
                                                   Margin="0,12,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource CardStyle}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="2. 还原与选项" Style="{DynamicResource CardTitleStyle}"/>
                                        <TextBlock Text="还原会把窗口样式、位置和原来的置顶状态一起还回去，和没改过一样。改动只影响窗口本身，不写注册表、不改游戏设置。" Style="{DynamicResource CardDescStyle}" Margin="0,3,0,14"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="还原窗口"
                                                    Click="WindowFullscreenRestoreButton_Click"
                                                    Style="{DynamicResource SmallGhostButtonStyle}"
                                                    ToolTip="把游戏窗口恢复成原来的样子（游戏里按 F11 切两次也能恢复）"/>
                                        </StackPanel>
                                        <CheckBox x:Name="WindowFullscreenCoverTaskbarCheckBox"
                                                  Style="{DynamicResource ToggleSwitchStyle}"
                                                  Margin="0,16,0,0"
                                                  Checked="WindowFullscreenOption_Changed"
                                                  Unchecked="WindowFullscreenOption_Changed">
                                            <StackPanel>
                                                <TextBlock Text="铺满整个屏幕" FontSize="13" FontWeight="Bold"/>
                                                <TextBlock Text="连任务栏一起盖住（关掉就只铺满工作区，任务栏还留着能用）" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="WindowFullscreenRestoreOnExitCheckBox"
                                                  Style="{DynamicResource ToggleSwitchStyle}"
                                                  Margin="0,16,0,0"
                                                  Checked="WindowFullscreenOption_Changed"
                                                  Unchecked="WindowFullscreenOption_Changed">
                                            <StackPanel>
                                                <TextBlock Text="关闭软件时自动还原" FontSize="13" FontWeight="Bold"/>
                                                <TextBlock Text="退出本软件时把游戏窗口改回原样，免得游戏一直是改过的状态" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource CardStyle}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="3. 用之前看一眼" Style="{DynamicResource CardTitleStyle}"/>
                                        <TextBlock Style="{DynamicResource HintStyle}" TextWrapping="Wrap" Margin="0,8,0,0" Text="1) 游戏得先是窗口化才能改。如果下拉框里那一条后面标着「看起来已经是全屏」，先在游戏里按 F11 切回窗口化，再点【变无边框全屏】。"/>
                                        <TextBlock Style="{DynamicResource HintStyle}" TextWrapping="Wrap" Margin="0,6,0,0" Text="2) 改完之后不要再按 F11，那是游戏自己的全屏，会把这里改好的样式顶掉。真按了也不要紧，再点一次【变无边框全屏】就行。"/>
                                        <TextBlock Style="{DynamicResource HintStyle}" TextWrapping="Wrap" Margin="0,6,0,0" Text="3) 万一软件崩了没来得及还原：重新打开软件点【还原窗口】，或者在游戏里按 F11 切两次，窗口也会回到正常样子。"/>
                                        <TextBlock Style="{DynamicResource HintStyle}" TextWrapping="Wrap" Margin="0,6,0,0" Text="4) 悬浮窗记得是开着的，本功能只负责让游戏窗口别压住它，不负责把悬浮窗叫出来。"/>
                                    </StackPanel>
                                </Border>
    </StackPanel>
</UserControl>
