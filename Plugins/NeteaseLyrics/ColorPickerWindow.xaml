<Window x:Class="MinecraftChatOverlay.Plugins.NeteaseLyrics.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择颜色" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Topmost="True" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <Border x:Name="Preview" Height="46" BorderBrush="#FF888888" BorderThickness="1" Background="White"/>
        <TextBlock x:Name="HexText" Margin="0,8,0,0" FontFamily="Consolas" FontSize="13" TextAlignment="Center"/>
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
            <TextBlock Text="R" VerticalAlignment="Center"/>
            <Slider x:Name="RSlider" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed"/>
            <TextBlock x:Name="RText" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"/>
        </Grid>
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
            <TextBlock Text="G" VerticalAlignment="Center"/>
            <Slider x:Name="GSlider" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed"/>
            <TextBlock x:Name="GText" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"/>
        </Grid>
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
            <TextBlock Text="B" VerticalAlignment="Center"/>
            <Slider x:Name="BSlider" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed"/>
            <TextBlock x:Name="BText" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"/>
        </Grid>
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
            <TextBlock Text="A" VerticalAlignment="Center"/>
            <Slider x:Name="ASlider" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed"/>
            <TextBlock x:Name="AText" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"/>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="恢复白色" Click="White_Click" Width="90"/>
            <Button Content="确定" Click="Ok_Click" Width="80" Margin="8,0,0,0" IsDefault="True"/>
            <Button Content="取消" Click="Cancel_Click" Width="80" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
