<Window x:Class="MinecraftChatOverlay.Plugins.NetEaseLyric.LyricWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网易云歌词"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        Width="1100"
        Height="190"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!--
      这个窗故意不用宿主的主题资源：歌词要的是"飘在游戏画面上"的观感，
      跟宿主那套卡片式界面不是一回事。颜色全部跟着插件设置走。
    -->
    <Grid x:Name="RootGrid">
        <StackPanel x:Name="ContentStack"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    Margin="24,10,24,10">

            <!-- 歌名 · 歌手 -->
            <TextBlock x:Name="TrackText"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,2"
                       Visibility="Collapsed"/>

            <!-- 当前句：主文字 + 后面一层影子（烘托游戏画面里的可读性） -->
            <Grid x:Name="CurrentLineHost" HorizontalAlignment="Center">
                <TextBlock x:Name="CurrentShadow"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="CurrentText"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Grid>

            <!-- 下一句预告 -->
            <TextBlock x:Name="NextText"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,6,0,0"
                       Visibility="Collapsed"/>

            <!-- 官方翻译 -->
            <TextBlock x:Name="TranslationText"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,4,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
