<Window x:Class="MinecraftChatOverlay.Plugins.ProcessFps.FpsOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FPS 悬浮窗"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- 尺寸交给内容自己撑（SizeToContent）：帧率从 60 跳到 120 时窗口会跟着变宽，
         位置不变（Left 固定）。这里不手动 SetWindowPos —— 刚显示时调它会把尺寸冻死。 -->
    <Border x:Name="RootBorder" CornerRadius="10" Padding="12,4" Background="#00000000">
        <TextBlock x:Name="FpsText"
                   Text="FPS --"
                   FontFamily="Microsoft YaHei UI"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White"
                   TextAlignment="Center">
            <TextBlock.Effect>
                <DropShadowEffect x:Name="TextShadow"
                                  Color="Black"
                                  BlurRadius="6"
                                  ShadowDepth="2"
                                  Direction="45"
                                  Opacity="0.8"/>
            </TextBlock.Effect>
        </TextBlock>
    </Border>
</Window>
