<UserControl x:Class="MinecraftChatOverlay.Plugins.AutoGg.AutoGgPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        这一页原来是主程序 MainWindow.Modern.xaml 里的 AutoGgPanel，整块搬过来了。
        注意：样式/画刷一律用 DynamicResource —— 插件控件是先 new 出来、再挂进宿主窗口的，
        用 StaticResource 在解析时找不到宿主 Window 里的资源字典（会直接抛 XamlParseException）。
    -->
    <StackPanel>
        <Border Style="{DynamicResource CardStyle}">
            <StackPanel>
                <CheckBox x:Name="EnableAutoGgCheckBox"
                          Style="{DynamicResource ToggleSwitchStyle}"
                          Checked="EnableAutoGgCheckBox_Changed"
                          Unchecked="EnableAutoGgCheckBox_Changed">
                    <StackPanel>
                        <TextBlock Text="启用自动 GG" FontSize="15" FontWeight="ExtraBold"/>
                        <TextBlock Text="检测到下方正则匹配的胜利消息时自动发送" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </CheckBox>

                <StackPanel x:Name="AutoGgBody" Visibility="Collapsed" Margin="0,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,16">
                            <TextBlock Text="触发正则" Style="{DynamicResource FieldLabelStyle}"/>
                            <TextBox x:Name="AutoGgTriggerTextBox" FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,9,0">
                            <TextBlock Text="打开聊天栏按键" Style="{DynamicResource FieldLabelStyle}"/>
                            <TextBox x:Name="AutoGgChatKeyTextBox" MaxLength="3"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="9,0,0,0">
                            <TextBlock Text="自动发送文字" Style="{DynamicResource FieldLabelStyle}"/>
                            <TextBox x:Name="AutoGgTextTextBox"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="AutoGgUseClipboardCheckBox"
                              Style="{DynamicResource ToggleSwitchStyle}"
                              Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="使用剪贴板粘贴方式发送" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="推荐，可避免中文输入法导致字母被吞 / 回车不发送" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox x:Name="AutoGgSendAgainCheckBox"
                              Style="{DynamicResource ToggleSwitchStyle}"
                              Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="发送 GG 后自动发送 /again" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="发完上面那段文字之后，隔一小会儿再自动输入 /again，省得手动打、方便接着再开一局" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <Border Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="13"
                            Padding="15,13"
                            Margin="0,16,0,0">
                        <TextBlock Text="触发时需要 Minecraft 窗口处于前台，程序会模拟按键。请先在小游戏 / 测试环境验证效果。"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="恢复默认" Click="AutoGgResetButton_Click"
                                Style="{DynamicResource SmallGhostButtonStyle}"/>
                        <TextBlock x:Name="AutoGgLastTriggerText" Grid.Column="1" Text="上次触发：从未"
                                   Style="{DynamicResource HintStyle}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>