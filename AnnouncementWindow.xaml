<Window x:Class="MinecraftChatOverlay.AnnouncementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="公告"
        Width="480"
        SizeToContent="Height"
        MaxHeight="660"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI, PingFang SC, sans-serif"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MinecraftChatOverlay;component/ModernControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="22,20,22,22">
        <StackPanel Orientation="Horizontal">
            <Border Background="{DynamicResource PrimarySoftBrush}"
                    CornerRadius="9"
                    Padding="9,3"
                    VerticalAlignment="Center">
                <TextBlock Text="公告"
                           FontSize="11.5"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Border>
            <TextBlock x:Name="DateText"
                       Style="{StaticResource HintStyle}"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
        </StackPanel>

        <TextBlock x:Name="TitleText"
                   Style="{StaticResource PanelTitleStyle}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"/>

        <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="16">
            <ScrollViewer MaxHeight="380"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="BodyText"
                           Style="{StaticResource BodyTextStyle}"/>
            </ScrollViewer>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="LinkButton"
                    Content="查看详情"
                    Click="LinkButton_Click"
                    Style="{StaticResource SmallButtonStyle}"
                    Margin="0,0,10,0"
                    Visibility="Collapsed"/>
            <Button Content="知道了"
                    Click="CloseButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="100"/>
        </StackPanel>
    </StackPanel>
</Window>
