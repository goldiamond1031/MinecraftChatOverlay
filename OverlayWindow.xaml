<Window x:Class="MinecraftChatOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MinecraftChatOverlay.Controls"
        Title="Minecraft 聊天悬浮窗"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border x:Name="RootBorder"
            CornerRadius="10"
            Background="#99000000"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            Padding="10,8"
            MouseEnter="RootBorder_MouseEnter"
            MouseLeave="RootBorder_MouseLeave">
        <ScrollViewer x:Name="ChatScroll"
                      MaxHeight="620"
                      VerticalScrollBarVisibility="Hidden">
            <ItemsControl x:Name="ChatList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,1,0,2" Padding="2,1">
                            <controls:SelectableChatTextBox Segments="{Binding Segments}"
                                       TextSelectionEnabled="{Binding TextSelectionEnabled}"
                                       FontFamily="{Binding FontFamily}"
                                       FontSize="{Binding FontSize}"
                                       Foreground="{Binding Foreground}"
                                       Effect="{Binding Shadow}"
                                       MaxWidth="{Binding MaxTextWidth}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</Window>
